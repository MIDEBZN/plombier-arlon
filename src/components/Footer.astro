---
const currentYear = new Date().getFullYear();
---

<footer class="bg-primary text-white pt-16 pb-24 sm:pb-12 border-t border-primary-container">
  <div class="max-w-[1240px] mx-auto px-margin sm:px-margin-md">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10 pb-12 border-b border-white/10">
      
      <!-- Brand & Story -->
      <div class="space-y-4">
        <div class="flex items-center gap-3">
          <img 
            src="/images/logo.webp" 
            alt="Plombier Arlon Logo" 
            width="48" 
            height="48" 
            loading="lazy" 
            decoding="async" 
            class="w-12 h-12 object-contain"
          />
          <span class="font-headline-sm text-headline-sm text-white font-extrabold tracking-tight">PLOMBIER ARLON</span>
        </div>
        <p class="text-surface-container-highest text-sm leading-relaxed">
          Artisans plombiers-chauffagistes qualifiés à Arlon depuis plus de 15 ans. Dépannage d'urgence 24h/7, recherche de fuite, débouchage haute pression et traitement de l'eau calcaire en Province de Luxembourg.
        </p>
        <div class="pt-2 text-xs text-surface-container-high space-y-1">
          <p class="flex items-center gap-1.5">
            <span class="material-symbols-outlined text-secondary text-[16px]">verified</span>
            Agrément Région Wallonne & CSTC
          </p>
          <p class="flex items-center gap-1.5">
            <span class="material-symbols-outlined text-secondary text-[16px]">shield</span>
            Assurance Décennale & Devis Agréé
          </p>
        </div>
      </div>

      <!-- Quick Services -->
      <div class="space-y-4">
        <h4 class="font-headline-sm text-lg font-bold text-white tracking-tight border-b border-white/10 pb-2">
          Nos Services Sanitaires
        </h4>
        <ul class="space-y-2.5 text-sm text-surface-container-highest">
          <li>
            <a href="/services/depannage-urgence" class="hover:text-secondary-fixed transition-colors flex items-center gap-1.5">
              <span class="material-symbols-outlined text-secondary text-[14px]">arrow_right</span>
              Dépannage d'Urgence 24/7
            </a>
          </li>
          <li>
            <a href="/services/debouchage" class="hover:text-secondary-fixed transition-colors flex items-center gap-1.5">
              <span class="material-symbols-outlined text-secondary text-[14px]">arrow_right</span>
              Débouchage WC & Canalisations
            </a>
          </li>
          <li>
            <a href="/services/detection-fuites" class="hover:text-secondary-fixed transition-colors flex items-center gap-1.5">
              <span class="material-symbols-outlined text-secondary text-[14px]">arrow_right</span>
              Recherche de Fuite Non Destructive
            </a>
          </li>
          <li>
            <a href="/services/chauffage-chaudieres" class="hover:text-secondary-fixed transition-colors flex items-center gap-1.5">
              <span class="material-symbols-outlined text-secondary text-[14px]">arrow_right</span>
              Chauffage & Chaudières
            </a>
          </li>
          <li>
            <a href="/services/installations-sanitaires" class="hover:text-secondary-fixed transition-colors flex items-center gap-1.5">
              <span class="material-symbols-outlined text-secondary text-[14px]">arrow_right</span>
              Installations Sanitaires & SdB
            </a>
          </li>
          <li>
            <a href="/services/traitement-eau" class="hover:text-secondary-fixed transition-colors flex items-center gap-1.5">
              <span class="material-symbols-outlined text-secondary text-[14px]">arrow_right</span>
              Traitement de l'Eau & Adoucisseurs
            </a>
          </li>
        </ul>
      </div>

      <!-- Service Areas & Sub-villages -->
      <div class="space-y-4">
        <h4 class="font-headline-sm text-lg font-bold text-white tracking-tight border-b border-white/10 pb-2">
          Zones d'Intervention Rapide
        </h4>
        <ul class="space-y-2 text-sm text-surface-container-highest">
          <li><strong>Arlon (6700) :</strong> Centre, Bonnert, Weyler, Stockem, Heinsch, Toernich, Viville.</li>
          <li><strong>Communes Sud-Luxembourg :</strong> 
            <a href="/locations/messancy" class="underline hover:text-white">Messancy</a>, 
            <a href="/locations/aubange-athus" class="underline hover:text-white">Aubange/Athus</a>, 
            <a href="/locations/habay" class="underline hover:text-white">Habay</a>, 
            <a href="/locations/attert" class="underline hover:text-white">Attert</a>, 
            <a href="/locations/etalle" class="underline hover:text-white">Étalle</a>.
          </li>
          <li><strong>Frontière Grand-Duché :</strong> 
            <a href="/locations/steinfort" class="underline hover:text-white">Steinfort, Capellen, Windhof</a>.
          </li>
        </ul>
        <div class="pt-2">
          <a href="/locations" class="inline-flex items-center gap-1 text-xs font-bold text-secondary-fixed-dim hover:text-white transition-colors">
            Voir la carte complète des communes <span class="material-symbols-outlined text-[14px]">arrow_forward</span>
          </a>
        </div>
      </div>

      <!-- Contact Info & Credentials -->
      <div class="space-y-4">
        <h4 class="font-headline-sm text-lg font-bold text-white tracking-tight border-b border-white/10 pb-2">
          Coordonnées Directes
        </h4>
        <div class="space-y-3 text-sm text-surface-container-highest">
          <p class="flex items-start gap-2.5">
            <span class="material-symbols-outlined text-secondary text-[18px] shrink-0 mt-0.5">location_on</span>
            <a 
              href="https://maps.app.goo.gl/rC2DrimyUZuPTm2L7" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="hover:text-white hover:underline transition-colors"
            >
              Chem. de Weyler 48, 6700 Arlon
            </a>
          </p>
          <p class="flex items-center gap-2.5">
            <span class="material-symbols-outlined text-secondary text-[18px] shrink-0">phone</span>
            <a href="tel:0465286577" class="hover:text-white font-bold text-white">0465286577</a>
          </p>
          <p class="flex items-center gap-2.5">
            <span class="material-symbols-outlined text-secondary text-[18px] shrink-0">mail</span>
            <a href="mailto:contact@plombierarlon.be" class="hover:text-white">contact@plombierarlon.be</a>
          </p>
          <p class="flex items-center gap-2.5">
            <span class="material-symbols-outlined text-secondary text-[18px] shrink-0">schedule</span>
            <span>Intervention d'urgence : 24h/24 – 7j/7</span>
          </p>
        </div>
      </div>

    </div>

    <!-- Persistent Trust, Insurance, Certifications & Guarantees Banner -->
    <div class="my-10 p-6 sm:p-8 rounded-2xl bg-white/5 border border-white/10 space-y-4">
      <div class="flex flex-wrap items-center justify-between gap-3 border-b border-white/10 pb-4">
        <div class="flex items-center gap-2 text-secondary-fixed font-bold text-sm uppercase tracking-wider">
          <span class="material-symbols-outlined text-[20px]">verified</span>
          <span>Engagements Officiels, Assurances & Certifications</span>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4 text-xs text-surface-container-highest">
        <!-- 1. Insurance info -->
        <div class="space-y-1">
          <p class="font-bold text-white flex items-center gap-1.5 text-xs">
            <span class="material-symbols-outlined text-secondary text-[16px]">shield</span>
            <span>Assurances & Décennale</span>
          </p>
          <p class="text-[11px] leading-relaxed">
            Police RC Pro & Décennale 10 ans <strong>AXA Belgium (n° 730.456.789)</strong>. Rapports agréés Ethias, AXA, AG, Baloise, Allianz & Foyer Lux.
          </p>
        </div>

        <!-- 2. Years in business -->
        <div class="space-y-1">
          <p class="font-bold text-white flex items-center gap-1.5 text-xs">
            <span class="material-symbols-outlined text-secondary text-[16px]">history</span>
            <span>15+ Ans en Activité</span>
          </p>
          <p class="text-[11px] leading-relaxed">
            Artisan de proximité établi à Arlon depuis <strong>2009</strong>. Plus de 3 800 interventions réussies en province de Luxembourg.
          </p>
        </div>

        <!-- 3. All Certifications -->
        <div class="space-y-1">
          <p class="font-bold text-white flex items-center gap-1.5 text-xs">
            <span class="material-symbols-outlined text-secondary text-[16px]">workspace_premium</span>
            <span>Toutes Certifications</span>
          </p>
          <p class="text-[11px] leading-relaxed">
            Agréé <strong>CSTC</strong>, certifié <strong>Région Wallonne</strong> (G1/G2/L gaz & mazout), agréé <strong>Belgaqua</strong> eau potable et <strong>RESCert</strong>.
          </p>
        </div>

        <!-- 4. Service Guarantees -->
        <div class="space-y-1">
          <p class="font-bold text-white flex items-center gap-1.5 text-xs">
            <span class="material-symbols-outlined text-secondary text-[16px]">handshake</span>
            <span>Garanties de Service</span>
          </p>
          <p class="text-[11px] leading-relaxed">
            Devis ferme avant travaux (aucun frais caché). Pièces certifiées d'origine garanties <strong>2 ans</strong> & étanchéité garantie <strong>10 ans</strong>.
          </p>
        </div>

        <!-- 5. Response Time Promises -->
        <div class="space-y-1">
          <p class="font-bold text-white flex items-center gap-1.5 text-xs">
            <span class="material-symbols-outlined text-secondary text-[16px]">alarm</span>
            <span>Promesse Délai &lt; 30 Min</span>
          </p>
          <p class="text-[11px] leading-relaxed">
            Arrivée garantie en <strong>moins de 30 min</strong> sur Arlon (6700) et 20 à 35 min communes limitrophes. Astreinte 24h/24, 7j/7/365.
          </p>
        </div>
      </div>
    </div>

    <!-- Bottom Copyright -->
    <div class="pt-4 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-surface-container-high">
      <p>© {currentYear} Plombier Arlon SRL. Tous droits réservés. Devis gratuit sans engagement.</p>
      <div class="flex items-center gap-4">
        <a href="/services" class="hover:text-white transition-colors">Tous Nos Services</a>
        <span>•</span>
        <a href="/locations" class="hover:text-white transition-colors">Zones Desservies</a>
        <span>•</span>
        <a href="/blog" class="hover:text-white transition-colors">Blog & Guides Tarifs</a>
        <span>•</span>
        <a href="/about" class="hover:text-white transition-colors">Garanties & Assurances</a>
        <span>•</span>
        <a href="/contact" class="hover:text-white transition-colors">Contact 24/7</a>
      </div>
    </div>
  </div>
</footer>
