---
// GoogleMapEmbed.astro: Embedded responsive Google Map of Simatec Plombier Arlon Urgent (Chem. de Weyler 48, 6700 Arlon)
---

<section class="w-full bg-surface-container-low/40 py-12 sm:py-16 border-t border-outline-variant/30" id="local-map">
  <div class="max-w-[1240px] mx-auto px-margin sm:px-margin-md space-y-6">
    
    <!-- Header with Address & Direction links -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
      <div class="space-y-2">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-secondary/10 text-secondary text-xs font-bold uppercase tracking-wider">
          <span class="material-symbols-outlined text-[16px]">location_on</span>
          <span>Implantation Locale à Arlon</span>
        </div>
        <h2 class="font-headline-md text-2xl sm:text-3xl font-extrabold text-primary tracking-tight">
          Notre Atelier & Dépôt : Chem. de Weyler 48, 6700 Arlon
        </h2>
        <p class="text-xs sm:text-sm text-on-surface-variant">
          Position stratégique permettant un départ immédiat vers Arlon Centre, les faubourgs et les communes voisines du Sud-Luxembourg.
        </p>
      </div>

      <!-- Quick Action Buttons -->
      <div class="flex flex-wrap items-center gap-3 shrink-0">
        <a 
          href="https://maps.app.goo.gl/rC2DrimyUZuPTm2L7" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="inline-flex items-center gap-2 bg-primary hover:bg-primary-container text-white px-4 py-2.5 rounded-xl font-bold text-xs shadow-sm transition-all"
        >
          <span class="material-symbols-outlined text-[16px]">directions</span>
          <span>Itinéraire Google Maps</span>
        </a>
        <a 
          href="tel:0465286577" 
          class="inline-flex items-center gap-2 bg-secondary hover:bg-secondary-container text-white px-4 py-2.5 rounded-xl font-bold text-xs shadow-sm transition-all"
        >
          <span class="material-symbols-outlined text-[16px]">call</span>
          <span>0465286577</span>
        </a>
      </div>
    </div>

    <!-- Responsive Iframe Container -->
    <div class="w-full rounded-2xl overflow-hidden shadow-lg border border-outline-variant/40 bg-white">
      <iframe 
        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2780.465962084641!2d5.813392676511535!3d49.67122857145398!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x88c9fa0d7390bbbf%3A0xfa4b77ae3456d8a9!2sSimatec%20Plombier%20Arlon%20Urgent!5e1!3m2!1sen!2sbe!4v1789507828487!5m2!1sen!2sbe" 
        width="100%" 
        height="450" 
        style="border:0;" 
        allowfullscreen="" 
        loading="lazy" 
        referrerpolicy="strict-origin-when-cross-origin"
        class="w-full h-[360px] sm:h-[450px] border-0 block"
        title="Localisation Google Maps Plombier Arlon - Chem. de Weyler 48"
      ></iframe>
    </div>

    <!-- Address & Status Bar -->
    <div class="flex flex-wrap items-center justify-between gap-3 text-xs text-on-surface-variant pt-1">
      <div class="flex items-center gap-2">
        <span class="h-2 w-2 rounded-full bg-emerald-500 animate-pulse"></span>
        <span class="font-semibold text-primary">Chem. de Weyler 48, 6700 Arlon</span>
        <span>•</span>
        <span>Intervention d'urgence 24h/24 & 7j/7</span>
      </div>
      <div class="flex items-center gap-2">
        <span class="material-symbols-outlined text-secondary text-[16px]">mail</span>
        <a href="mailto:contact@plombierarlon.be" class="hover:underline text-primary font-semibold">contact@plombierarlon.be</a>
      </div>
    </div>

  </div>
</section>
