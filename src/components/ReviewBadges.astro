---
// ReviewBadges.astro: Multi-platform review badges and verified ratings breakdown
---

<section class="py-12 bg-white border-b border-outline-variant/30" id="review-badges">
  <div class="max-w-[1240px] mx-auto px-margin sm:px-margin-md">
    
    <!-- Top Summary Banner -->
    <div class="bg-surface-container-low/70 rounded-2xl p-6 sm:p-8 border border-outline-variant/40 space-y-8">
      
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        
        <!-- Left: Overall Rating & Verified Star Display -->
        <div class="lg:col-span-4 flex flex-col items-center lg:items-start text-center lg:text-left space-y-3">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-50 text-emerald-700 text-xs font-extrabold border border-emerald-200">
            <span class="material-symbols-outlined text-[16px] text-emerald-600">verified</span>
            <span>Évaluations 100% Certifiées</span>
          </div>

          <div class="flex items-baseline gap-3">
            <span class="font-headline-xl text-5xl sm:text-6xl font-extrabold text-primary tracking-tight">
              4.9
            </span>
            <span class="text-on-surface-variant font-bold text-xl">/ 5</span>
          </div>

          <div class="flex text-amber-400 text-2xl leading-none">
            <span>★</span><span>★</span><span>★</span><span>★</span><span>★</span>
          </div>

          <p class="text-xs sm:text-sm text-on-surface-variant leading-relaxed">
            Note globale calculée sur <strong class="text-primary font-bold">184 interventions vérifiées</strong> réalisées sur l'entité d'Arlon et les communes limitrophes.
          </p>
        </div>

        <!-- Center: Star Rating Breakdown Bar -->
        <div class="lg:col-span-4 space-y-2 border-y lg:border-y-0 lg:border-x border-outline-variant/40 py-6 lg:py-0 lg:px-8">
          <div class="text-xs font-bold text-primary mb-2 flex items-center justify-between">
            <span>Répartition des Avis Clients</span>
            <span class="text-emerald-700 font-extrabold">99.1% Positifs</span>
          </div>

          <!-- 5 Stars -->
          <div class="flex items-center gap-2 text-xs">
            <span class="w-12 font-medium text-on-surface-variant text-right">5 étoiles</span>
            <div class="flex-grow h-2.5 bg-surface-container rounded-full overflow-hidden">
              <div class="h-full bg-amber-400 rounded-full w-[96%]"></div>
            </div>
            <span class="w-8 font-bold text-primary text-right">96%</span>
          </div>

          <!-- 4 Stars -->
          <div class="flex items-center gap-2 text-xs">
            <span class="w-12 font-medium text-on-surface-variant text-right">4 étoiles</span>
            <div class="flex-grow h-2.5 bg-surface-container rounded-full overflow-hidden">
              <div class="h-full bg-amber-400/80 rounded-full w-[4%]"></div>
            </div>
            <span class="w-8 font-bold text-primary text-right">4%</span>
          </div>

          <!-- 3 Stars -->
          <div class="flex items-center gap-2 text-xs text-outline">
            <span class="w-12 text-right">3 étoiles</span>
            <div class="flex-grow h-2.5 bg-surface-container rounded-full overflow-hidden">
              <div class="h-full bg-amber-400/30 rounded-full w-[0%]"></div>
            </div>
            <span class="w-8 text-right">0%</span>
          </div>

          <!-- 2 Stars -->
          <div class="flex items-center gap-2 text-xs text-outline">
            <span class="w-12 text-right">2 étoiles</span>
            <div class="flex-grow h-2.5 bg-surface-container rounded-full overflow-hidden">
              <div class="h-full bg-amber-400/30 rounded-full w-[0%]"></div>
            </div>
            <span class="w-8 text-right">0%</span>
          </div>

          <!-- 1 Star -->
          <div class="flex items-center gap-2 text-xs text-outline">
            <span class="w-12 text-right">1 étoile</span>
            <div class="flex-grow h-2.5 bg-surface-container rounded-full overflow-hidden">
              <div class="h-full bg-amber-400/30 rounded-full w-[0%]"></div>
            </div>
            <span class="w-8 text-right">0%</span>
          </div>
        </div>

        <!-- Right: Official Platform Badges -->
        <div class="lg:col-span-4 grid grid-cols-2 gap-3">
          
          <!-- Google Reviews Badge -->
          <div class="bg-white p-3.5 rounded-xl border border-outline-variant/40 shadow-sm flex flex-col items-center text-center space-y-1">
            <div class="w-8 h-8 flex items-center justify-center">
              <svg class="w-6 h-6" viewBox="0 0 24 24">
                <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
                <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
              </svg>
            </div>
            <span class="text-[11px] font-bold text-primary">Google Reviews</span>
            <div class="flex text-amber-400 text-xs">★★★★★</div>
            <span class="text-[10px] text-outline font-semibold">4.9/5 • 184 avis</span>
          </div>

          <!-- TrustScore Plomberie -->
          <div class="bg-white p-3.5 rounded-xl border border-outline-variant/40 shadow-sm flex flex-col items-center text-center space-y-1">
            <div class="w-8 h-8 rounded-full bg-emerald-100 flex items-center justify-center text-emerald-700">
              <span class="material-symbols-outlined text-[20px]">shield</span>
            </div>
            <span class="text-[11px] font-bold text-primary">TrustScore Belgique</span>
            <span class="text-xs font-extrabold text-emerald-700">9.8 / 10</span>
            <span class="text-[10px] text-outline font-semibold">Excellence Métier</span>
          </div>

          <!-- Pages d'Or / Truvo -->
          <div class="bg-white p-3.5 rounded-xl border border-outline-variant/40 shadow-sm flex flex-col items-center text-center space-y-1">
            <div class="w-8 h-8 rounded-full bg-amber-100 flex items-center justify-center text-amber-700 font-extrabold text-xs">
              PO
            </div>
            <span class="text-[11px] font-bold text-primary">Pages d'Or Arlon</span>
            <span class="text-xs font-extrabold text-primary">Recommandé</span>
            <span class="text-[10px] text-outline font-semibold">99% Satisfaction</span>
          </div>

          <!-- Garantie Assurance sans Litige -->
          <div class="bg-white p-3.5 rounded-xl border border-outline-variant/40 shadow-sm flex flex-col items-center text-center space-y-1">
            <div class="w-8 h-8 rounded-full bg-primary/10 flex items-center justify-center text-primary">
              <span class="material-symbols-outlined text-[20px]">verified_user</span>
            </div>
            <span class="text-[11px] font-bold text-primary">Assurance AXA</span>
            <span class="text-xs font-extrabold text-emerald-700">0 Litige</span>
            <span class="text-[10px] text-outline font-semibold">Garantie 10 Ans</span>
          </div>

        </div>

      </div>

      <!-- Trust Assurance Bar Bottom Line -->
      <div class="pt-4 border-t border-outline-variant/40 flex flex-wrap items-center justify-between gap-4 text-xs text-on-surface-variant">
        <div class="flex items-center gap-2">
          <span class="material-symbols-outlined text-secondary text-[18px]">verified</span>
          <span>Avis modérés et conformes aux normes AFNOR NF Z74-501 (authenticité des avis consommateurs)</span>
        </div>
        <div class="flex items-center gap-3 font-semibold text-primary">
          <span>✓ Intervention sous devis écrit</span>
          <span>✓ Facture officielle déductible</span>
          <span>✓ Prise en charge assurance</span>
        </div>
      </div>

    </div>

  </div>
</section>
