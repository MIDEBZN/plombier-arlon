---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileStickyCall from '../components/MobileStickyCall.astro';
import WhatsAppChatWidget from '../components/WhatsAppChatWidget.astro';
import GoogleMapEmbed from '../components/GoogleMapEmbed.astro';
import '../styles/global.css';

export interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  schemaType?: string;
}

const { 
  title, 
  description, 
  canonicalPath = '',
  schemaType = 'Plumber'
} = Astro.props;

const siteUrl = 'https://www.plombierarlon.be';
const canonicalUrl = `${siteUrl}${canonicalPath ? canonicalPath : Astro.url.pathname}`;

