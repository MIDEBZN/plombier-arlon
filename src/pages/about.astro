---
import Layout from '../layouts/Layout.astro';
import TrustBar from '../components/TrustBar.astro';
import QuickQuoteForm from '../components/QuickQuoteForm.astro';
import TrustBadges from '../components/TrustBadges.astro';
import ResponseTimeStats from '../components/ResponseTimeStats.astro';
---

<Layout 
  title="À Propos de Plombier Arlon | Artisan Plombier Chauffagiste Local 6700"
  description="Découvrez l'équipe de Plombier Arlon : plus de 15 ans d'expérience dans le Sud-Luxembourg, agréé CSTC et compagnies d'assurances. Artisans qualifiés, matériel de pointe et transparence tarifaire."
  canonicalPath="/about"
>
  <!-- Page Header -->
  <section class="bg-primary text-white py-12 lg:py-16 border-b border-primary-container">
    <div class="max-w-[1240px] mx-auto px-margin sm:px-margin-md space-y-4">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/10 w-fit text-xs font-bold uppercase tracking-wider text-secondary-fixed">
        <span class="material-symbols-outlined text-[16px]">verified</span>
        <span>Artisan Belge Enregistré • BCE : BE 0799.456.123</span>
      </div>
      <h1 class="font-headline-xl text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight">
        Votre Entreprise de Plomberie de Proximité à Arlon
      </h1>
      <p class="text-surface-container-highest max-w-3xl text-base sm:text-lg leading-relaxed">
        Depuis plus de 15 ans, notre équipe d'artisans plombiers et techniciens sanitaires intervient avec rigueur, rapidité et transparence auprès des résidents, commerçants et régies immobilières d'Arlon et du Sud-Luxembourg.
      </p>
    </div>
  </section>

  <TrustBar />

  <!-- Response Time & Performance Stats -->
  <ResponseTimeStats />

  <!-- Story & Local Roots -->
  <section class="py-16 bg-surface">
    <div class="max-w-[1240px] mx-auto px-margin sm:px-margin-md space-y-16">
      
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <div class="lg:col-span-7 space-y-6">
          <div class="inline-flex items-center gap-2 text-secondary font-bold text-xs uppercase tracking-wider">
            <span class="h-2 w-2 rounded-full bg-secondary"></span> Ancrage Local & Savoir-Faire
          </div>
          <h2 class="font-headline-lg text-2xl sm:text-3xl lg:text-4xl font-extrabold text-primary">
            L'Exigence du Travail Bien Fait, Sans Intermédiaire
          </h2>
          <p class="text-on-surface-variant text-base leading-relaxed">
            Plombier Arlon est né d'un constat simple : trop d'habitants de notre région faisaient face à des plates-formes de mise en relation basées à Bruxelles ou en Flandre, envoyant des sous-traitants non qualifiés avec des factures exorbitantes et aucun service après-vente.
          </p>
          <p class="text-on-surface-variant text-base leading-relaxed">
            Nous avons fait le choix opposé : un <strong>atelier physique au coeur d'Arlon (Chem. de Weyler 48)</strong>, une équipe soudée de professionnels diplômés, un stock permanent de pièces d'origine dans nos véhicules et une parfaite connaissance des spécificités techniques locales — notamment la forte minéralisation de l'eau du bassin arlonais (+32 °fH).
          </p>
          
          <div class="grid grid-cols-2 sm:grid-cols-3 gap-6 pt-4 border-t border-outline-variant/30">
            <div>
              <p class="text-3xl sm:text-4xl font-extrabold text-primary">15+</p>
              <p class="text-xs text-on-surface-variant font-medium mt-1">Années de métier</p>
            </div>
            <div>
              <p class="text-3xl sm:text-4xl font-extrabold text-secondary">3 800+</p>
              <p class="text-xs text-on-surface-variant font-medium mt-1">Interventions réussies</p>
            </div>
            <div>
              <p class="text-3xl sm:text-4xl font-extrabold text-primary">4.9/5</p>
              <p class="text-xs text-on-surface-variant font-medium mt-1">Avis clients vérifiés</p>
            </div>
          </div>
        </div>

        <div class="lg:col-span-5 bg-surface-container-low p-8 rounded-3xl border border-outline-variant/40 space-y-6 shadow-sm">
          <h3 class="font-headline-sm text-xl font-bold text-primary flex items-center gap-2">
            <span class="material-symbols-outlined text-secondary">handshake</span>
            <span>Nos 4 Engagements Fondamentaux</span>
          </h3>
          
          <div class="space-y-4">
            <div class="flex items-start gap-3">
              <span class="p-1.5 rounded-lg bg-primary/10 text-primary shrink-0 mt-0.5">
                <span class="material-symbols-outlined text-[18px]">receipt_long</span>
              </span>
              <div>
                <p class="font-bold text-sm text-primary">Devis Écrit & Prix Transparent</p>
                <p class="text-xs text-on-surface-variant mt-0.5">Aucun travail n'est commencé sans votre validation préalable du montant estimé.</p>
              </div>
            </div>

            <div class="flex items-start gap-3">
              <span class="p-1.5 rounded-lg bg-primary/10 text-primary shrink-0 mt-0.5">
                <span class="material-symbols-outlined text-[18px]">timer</span>
              </span>
              <div>
                <p class="font-bold text-sm text-primary">Ponctualité & Réactivité 24/7</p>
                <p class="text-xs text-on-surface-variant mt-0.5">En urgence, notre technicien d'astreinte arrive sous 30 minutes sur Arlon.</p>
              </div>
            </div>

            <div class="flex items-start gap-3">
              <span class="p-1.5 rounded-lg bg-primary/10 text-primary shrink-0 mt-0.5">
                <span class="material-symbols-outlined text-[18px]">workspace_premium</span>
              </span>
              <div>
                <p class="font-bold text-sm text-primary">Matériel de Grandes Marques</p>
                <p class="text-xs text-on-surface-variant mt-0.5">Composants certifiés Belgaqua : Grohe, Geberit, BWT, Bulex, Atlantic, Van Marcke.</p>
              </div>
            </div>

            <div class="flex items-start gap-3">
              <span class="p-1.5 rounded-lg bg-primary/10 text-primary shrink-0 mt-0.5">
                <span class="material-symbols-outlined text-[18px]">shield</span>
              </span>
              <div>
                <p class="font-bold text-sm text-primary">Agrément Assurances & Garantie</p>
                <p class="text-xs text-on-surface-variant mt-0.5">Rapports d'expertise reconnus par Ethias, AXA, AG, Baloise et DKV.</p>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Real Field Photos Section (Optimized WebP with Lazy Loading) -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-4">
        <div class="space-y-2">
          <div class="rounded-2xl overflow-hidden border border-outline-variant/40 shadow-sm aspect-video bg-slate-100">
            <img 
              src="/images/plombier-arlon-camionnette.webp" 
              alt="Camionnette atelier de Plombier Arlon dans le centre d'Arlon" 
              width="600" 
              height="338" 
              loading="lazy" 
              decoding="async" 
              class="w-full h-full object-cover hover:scale-105 transition-transform duration-300"
            />
          </div>
          <p class="text-xs text-on-surface-variant text-center font-medium">
            🚐 Véhicule atelier approvisionné en pièces d'origine, basé à Arlon pour départ immédiat 24h/24.
          </p>
        </div>

        <div class="space-y-2">
          <div class="rounded-2xl overflow-hidden border border-outline-variant/40 shadow-sm aspect-video bg-slate-100">
            <img 
              src="/images/intervention-plomberie.webp" 
              alt="Artisan plombier qualifié en réparation de tuyauterie cuivre à Arlon" 
              width="600" 
              height="338" 
              loading="lazy" 
              decoding="async" 
              class="w-full h-full object-cover hover:scale-105 transition-transform duration-300"
            />
          </div>
          <p class="text-xs text-on-surface-variant text-center font-medium">
            🔧 Artisans qualifiés diplômés : soudures cuivre, raccords multicouche et remplacement de robinetterie.
          </p>
        </div>
      </div>

      <!-- Specialized Equipment Section -->
      <div class="space-y-8 pt-8 border-t border-outline-variant/30">
        <div class="text-center max-w-2xl mx-auto space-y-2">
          <span class="text-xs font-bold text-secondary uppercase tracking-widest">Technologie & Outillage</span>
          <h2 class="font-headline-lg text-2xl sm:text-3xl font-extrabold text-primary">
            Des Équipements Professionnels de Haute Précision
          </h2>
          <p class="text-on-surface-variant text-sm sm:text-base">
            Pour diagnostiquer et résoudre vos pannes sans dégâts collatéraux inutiles dans votre habitation.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          
          <div class="bg-white p-6 rounded-2xl border border-outline-variant/40 shadow-sm space-y-4">
            <div class="h-12 w-12 rounded-xl bg-primary/10 flex items-center justify-center text-primary">
              <span class="material-symbols-outlined text-[28px]">videocam</span>
            </div>
            <h3 class="font-bold text-lg text-primary">Caméras Vidéo Endoscopiques</h3>
            <p class="text-xs text-on-surface-variant leading-relaxed">
              Têtes de caméras axiales et rotatives avec sonde émettrice pour inspecter les canalisations du Ø 32 au Ø 200 mm. Localisation exacte des casses, racines, bouchons et affaissements avec enregistrement vidéo pour votre assurance.
            </p>
            <div class="text-xs font-semibold text-primary">Marques : RIDGID SeeSnake, Rothenberger</div>
          </div>

          <div class="bg-white p-6 rounded-2xl border border-outline-variant/40 shadow-sm space-y-4">
            <div class="h-12 w-12 rounded-xl bg-primary/10 flex items-center justify-center text-primary">
              <span class="material-symbols-outlined text-[28px]">thermostat</span>
            </div>
            <h3 class="font-bold text-lg text-primary">Thermographie & Électro-Acoustique</h3>
            <p class="text-xs text-on-surface-variant leading-relaxed">
              Caméras thermiques infrarouges de haute sensibilité et microphones de sol ultrasensibles pour détecter les fuites d'eau chaude, de chauffage par le sol ou de conduites d'alimentation encastrées sans casser un seul carrelage.
            </p>
            <div class="text-xs font-semibold text-primary">Marques : FLIR E6/E8, Sewerin Stethophon</div>
          </div>

          <div class="bg-white p-6 rounded-2xl border border-outline-variant/40 shadow-sm space-y-4">
            <div class="h-12 w-12 rounded-xl bg-primary/10 flex items-center justify-center text-primary">
              <span class="material-symbols-outlined text-[28px]">water</span>
            </div>
            <h3 class="font-bold text-lg text-primary">Unité Mobile Hydrocureuse</h3>
            <p class="text-xs text-on-surface-variant leading-relaxed">
              Véhicule équipé d'une pompe haute pression pulsée (jusqu'à 200 bars) avec buses rotatives spéciales graisses, calcaire et racines. Nettoyage et curage complet des égouts, colonnes et collecteurs d'eaux pluviales.
            </p>
            <div class="text-xs font-semibold text-primary">Hydrocurage écologique sans acide nocif</div>
          </div>

        </div>
      </div>

      <!-- Legal & Accreditations -->
      <div class="bg-surface-container-low rounded-3xl p-8 sm:p-12 border border-outline-variant/40 space-y-8">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
          <div class="lg:col-span-8 space-y-4">
            <span class="text-xs font-bold text-primary uppercase tracking-widest">Conformité Légale & Assurances</span>
            <h2 class="font-headline-lg text-2xl sm:text-3xl font-extrabold text-primary">
              Agréments Professionnels & Informations Légales
            </h2>
            <p class="text-on-surface-variant text-sm leading-relaxed">
              Toutes nos interventions sont exécutées selon les Règles de l'Art édictées par le CSTC (Centre Scientifique et Technique de la Construction). Nous fournissons systématiquement une facture conforme et un rapport technique détaillé pour votre compagnie d'assurance en cas de dégât des eaux.
            </p>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs text-on-surface pt-2">
              <div class="bg-white p-3 rounded-xl border border-outline-variant/30 space-y-1">
                <span class="text-outline font-semibold">Numéro d'Entreprise & TVA :</span>
                <p class="font-mono font-bold text-primary">BE 0799.456.123</p>
              </div>
              <div class="bg-white p-3 rounded-xl border border-outline-variant/30 space-y-1">
                <span class="text-outline font-semibold">Siège & Atelier :</span>
                <p class="font-bold text-primary">Rue des Faubourgs 14, 6700 Arlon</p>
              </div>
              <div class="bg-white p-3 rounded-xl border border-outline-variant/30 space-y-1">
                <span class="text-outline font-semibold">Assurance Responsabilité Civile :</span>
                <p class="font-bold text-primary">Police RC Professionnelle AXA Belgium</p>
              </div>
              <div class="bg-white p-3 rounded-xl border border-outline-variant/30 space-y-1">
                <span class="text-outline font-semibold">Conformité Sanitaire :</span>
                <p class="font-bold text-primary">Normes Belgaqua & Région Wallonne</p>
              </div>
            </div>
          </div>

          <div class="lg:col-span-4 bg-primary text-white p-6 sm:p-8 rounded-2xl space-y-4 text-center">
            <span class="material-symbols-outlined text-secondary-fixed text-[44px]">verified_user</span>
            <h3 class="font-headline-sm text-lg font-bold">Sinistre ou Dégât des Eaux ?</h3>
            <p class="text-xs text-surface-container-highest">
              Nous intervenons en urgence pour stopper la fuite et établissons immédiatement le rapport chiffré pour votre assureur.
            </p>
            <a href="tel:+32472902010" class="w-full inline-flex items-center justify-center gap-2 bg-secondary hover:bg-secondary-container text-white py-3 px-4 rounded-xl font-bold text-sm shadow-md transition-all">
              <span class="material-symbols-outlined text-[18px]">call</span>
              <span>0472 90 20 10</span>
            </a>
          </div>
        </div>
      </div>

      <!-- Trust Badges & Accreditations -->
      <TrustBadges />

      <!-- Contact & Quote Form Section -->
      <div id="contact-form" class="pt-8">
        <QuickQuoteForm />
      </div>

    </div>
  </section>
</Layout>
