---
import Layout from '../layouts/Layout.astro';
import TrustBar from '../components/TrustBar.astro';
import QuickQuoteForm from '../components/QuickQuoteForm.astro';
---

<Layout 
  title="Zones d'Intervention Plomberie Arlon (6700) & Sud-Luxembourg | Arrivée 30 Min"
  description="Intervention plomberie urgente à Arlon (Centre, Bonnert, Weyler, Stockem, Heinsch) et Sud-Luxembourg (Messancy, Aubange, Habay, Attert) + Frontière Luxembourg (Steinfort, Capellen). Arrivée en 30 min."
  canonicalPath="/locations"
>
  <!-- Page Header -->
  <section class="bg-primary text-white py-12 lg:py-16 border-b border-primary-container">
    <div class="max-w-[1240px] mx-auto px-margin sm:px-margin-md space-y-4">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/10 w-fit text-xs font-bold uppercase tracking-wider text-secondary-fixed">
        <span class="material-symbols-outlined text-[16px]">pin_drop</span>
        <span>Atelier & Véhicules Basés à Arlon 6700</span>
      </div>
      <h1 class="font-headline-xl text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight">
        Zones d'Intervention : Arlon (6700) & Sud-Luxembourg
      </h1>
      <p class="text-surface-container-highest max-w-3xl text-base sm:text-lg leading-relaxed">
        Contrairement aux plateformes d'intermédiation basées à Bruxelles ou Liège, nos artisans plombiers sont physiquement situés à Arlon. Résultat : une arrivée sur site en 20 à 30 minutes chrono et zéro frais kilométrique abusif.
      </p>
    </div>
  </section>

  <TrustBar />

  <!-- Main Local Zones Section -->
  <section class="py-16 bg-surface">
    <div class="max-w-[1240px] mx-auto px-margin sm:px-margin-md space-y-16">
      
      <!-- Arlon & Sections communales -->
      <div class="space-y-8">
        <div class="space-y-2">
          <div class="inline-flex items-center gap-2 text-secondary font-bold text-xs uppercase tracking-wider">
            <span class="h-2 w-2 rounded-full bg-secondary"></span> Coeur de Ville & Villages de la Commune
          </div>
          <h2 class="font-headline-lg text-2xl sm:text-3xl text-primary font-bold">
            Intervention Prioritaire à Arlon (Code Postal 6700)
          </h2>
          <p class="text-on-surface-variant max-w-2xl text-sm sm:text-base">
            Véhicules d'intervention équipés en permanence pour le débouchage haute pression, la détection de fuite et le dépannage de chauffe-eau sur l'ensemble du grand Arlon.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          
          <!-- Arlon Centre -->
          <div class="bg-white p-6 rounded-2xl border border-outline-variant/40 shadow-sm hover:border-primary/50 transition-all">
            <div class="flex items-center justify-between mb-4">
              <span class="font-bold text-lg text-primary">Arlon Centre & Faubourgs</span>
              <span class="text-xs bg-emerald-100 text-emerald-800 font-bold px-2.5 py-0.5 rounded-full">15-20 min</span>
            </div>
            <p class="text-xs text-on-surface-variant mb-4 leading-relaxed">
              Grand-Place, Place Léopold, Rue des Déportés, Rue de Diekirch, Rue des Faubourgs, quartier Gare et Clinique Edmond Jacques.
            </p>
            <ul class="text-xs space-y-1.5 text-on-surface font-medium border-t border-surface-container pt-3">
              <li class="flex items-center gap-1.5"><span class="material-symbols-outlined text-secondary text-[16px]">check</span> Dépannage fuite appartements & résidences</li>
              <li class="flex items-center gap-1.5"><span class="material-symbols-outlined text-secondary text-[16px]">check</span> Remplacement robinetterie & WC suspendus</li>
            </ul>
          </div>

          <!-- Bonnert & Frassem -->
          <div class="bg-white p-6 rounded-2xl border border-outline-variant/40 shadow-sm hover:border-primary/50 transition-all">
            <div class="flex items-center justify-between mb-4">
              <span class="font-bold text-lg text-primary">Bonnert & Frassem</span>
              <span class="text-xs bg-emerald-100 text-emerald-800 font-bold px-2.5 py-0.5 rounded-full">15-25 min</span>
            </div>
            <p class="text-xs text-on-surface-variant mb-4 leading-relaxed">
              Zones résidentielles des hauteurs de Bonnert, Platennau, Frassem et carrefour vers Beckerich.
            </p>
            <ul class="text-xs space-y-1.5 text-on-surface font-medium border-t border-surface-container pt-3">
              <li class="flex items-center gap-1.5"><span class="material-symbols-outlined text-secondary text-[16px]">check</span> Protection calcaire & adoucisseurs (+32 °fH)</li>
              <li class="flex items-center gap-1.5"><span class="material-symbols-outlined text-secondary text-[16px]">check</span> Dégorgement canalisation villa & pavillons</li>
            </ul>
          </div>

          <!-- Weyler & Autelbas -->
          <div class="bg-white p-6 rounded-2xl border border-outline-variant/40 shadow-sm hover:border-primary/50 transition-all">
            <div class="flex items-center justify-between mb-4">
              <span class="font-bold text-lg text-primary">Weyler, Autelbas & Barnich</span>
              <span class="text-xs bg-emerald-100 text-emerald-800 font-bold px-2.5 py-0.5 rounded-full">20 min</span>
            </div>
            <p class="text-xs text-on-surface-variant mb-4 leading-relaxed">
              Axe N81, Route de Luxembourg, Autelbas-Village et Sterpenich (proche autoroute E411).
            </p>
            <ul class="text-xs space-y-1.5 text-on-surface font-medium border-t border-surface-container pt-3">
              <li class="flex items-center gap-1.5"><span class="material-symbols-outlined text-secondary text-[16px]">check</span> Débouchage express chambre de visite</li>
              <li class="flex items-center gap-1.5"><span class="material-symbols-outlined text-secondary text-[16px]">check</span> Dépannage urgent chauffe-eau électrique & gaz</li>
            </ul>
          </div>

          <!-- Stockem & Fouches -->
          <div class="bg-white p-6 rounded-2xl border border-outline-variant/40 shadow-sm hover:border-primary/50 transition-all">
            <div class="flex items-center justify-between mb-4">
              <span class="font-bold text-lg text-primary">Stockem & Fouches</span>
              <span class="text-xs bg-emerald-100 text-emerald-800 font-bold px-2.5 py-0.5 rounded-full">20 min</span>
            </div>
            <p class="text-xs text-on-surface-variant mb-4 leading-relaxed">
              Quartier de la gare de Stockem, axe N4 vers Habay et Fouches village.
            </p>
            <ul class="text-xs space-y-1.5 text-on-surface font-medium border-t border-surface-container pt-3">
              <li class="flex items-center gap-1.5"><span class="material-symbols-outlined text-secondary text-[16px]">check</span> Réparation tuyauterie gelée en hiver</li>
              <li class="flex items-center gap-1.5"><span class="material-symbols-outlined text-secondary text-[16px]">check</span> Détection acoustique de fuite enterrée</li>
            </ul>
          </div>

          <!-- Heinsch & Freylange -->
          <div class="bg-white p-6 rounded-2xl border border-outline-variant/40 shadow-sm hover:border-primary/50 transition-all">
            <div class="flex items-center justify-between mb-4">
              <span class="font-bold text-lg text-primary">Heinsch, Freylange & Viville</span>
              <span class="text-xs bg-emerald-100 text-emerald-800 font-bold px-2.5 py-0.5 rounded-full">20 min</span>
            </div>
            <p class="text-xs text-on-surface-variant mb-4 leading-relaxed">
              Zone semi-rurale et lotissements récents vers Heinsch, Schoppach et Viville.
            </p>
            <ul class="text-xs space-y-1.5 text-on-surface font-medium border-t border-surface-container pt-3">
              <li class="flex items-center gap-1.5"><span class="material-symbols-outlined text-secondary text-[16px]">check</span> Rénovation salle de bain PMR & douche italienne</li>
              <li class="flex items-center gap-1.5"><span class="material-symbols-outlined text-secondary text-[16px]">check</span> Inspection caméra vidéo des évacuations</li>
            </ul>
          </div>

          <!-- Toernich & Sesselich -->
          <div class="bg-white p-6 rounded-2xl border border-outline-variant/40 shadow-sm hover:border-primary/50 transition-all">
            <div class="flex items-center justify-between mb-4">
              <span class="font-bold text-lg text-primary">Toernich, Sesselich & Udange</span>
              <span class="text-xs bg-emerald-100 text-emerald-800 font-bold px-2.5 py-0.5 rounded-full">20-25 min</span>
            </div>
            <p class="text-xs text-on-surface-variant mb-4 leading-relaxed">
              Sud de la commune d'Arlon vers Wolkrange et Messancy.
            </p>
            <ul class="text-xs space-y-1.5 text-on-surface font-medium border-t border-surface-container pt-3">
              <li class="flex items-center gap-1.5"><span class="material-symbols-outlined text-secondary text-[16px]">check</span> Hydrocurage haute pression fosse septique</li>
              <li class="flex items-center gap-1.5"><span class="material-symbols-outlined text-secondary text-[16px]">check</span> Remplacement réducteur de pression</li>
            </ul>
          </div>

        </div>
      </div>

      <!-- Communes Limitrophes Sud-Luxembourg -->
      <div class="space-y-8 pt-8 border-t border-outline-variant/30">
        <div class="space-y-2">
          <div class="inline-flex items-center gap-2 text-primary font-bold text-xs uppercase tracking-wider">
            <span class="material-symbols-outlined text-[16px]">local_shipping</span> Grand Arlon & Province de Luxembourg
          </div>
          <h2 class="font-headline-lg text-2xl sm:text-3xl text-primary font-bold">
            Communes Voisines Couvertes en 30 à 45 Minutes
          </h2>
          <p class="text-on-surface-variant max-w-2xl text-sm sm:text-base">
            Nous intervenons quotidiennement auprès des particuliers, régies immobilières et commerces des communes du Sud de la province de Luxembourg.
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          
          <div class="bg-surface-container-low p-6 rounded-xl border border-outline-variant/40 space-y-3">
            <div class="flex items-center gap-2 font-bold text-primary text-base">
              <span class="material-symbols-outlined text-secondary">location_on</span>
              <span>Messancy (6780)</span>
            </div>
            <p class="text-xs text-on-surface-variant">
              Wolkrange, Bébange, Habergy, Turpange et zone commerciale Cora Messancy.
            </p>
            <div class="text-xs font-semibold text-primary">Délai estimé : 15 à 25 min</div>
          </div>

          <div class="bg-surface-container-low p-6 rounded-xl border border-outline-variant/40 space-y-3">
            <div class="flex items-center gap-2 font-bold text-primary text-base">
              <span class="material-symbols-outlined text-secondary">location_on</span>
              <span>Aubange & Athus (6790)</span>
            </div>
            <p class="text-xs text-on-surface-variant">
              Athus, Halanzy, Rachecourt. Dépannages urgents en zone frontalière trinationale.
            </p>
            <div class="text-xs font-semibold text-primary">Délai estimé : 25 à 35 min</div>
          </div>

          <div class="bg-surface-container-low p-6 rounded-xl border border-outline-variant/40 space-y-3">
            <div class="flex items-center gap-2 font-bold text-primary text-base">
              <span class="material-symbols-outlined text-secondary">location_on</span>
              <span>Habay (6720)</span>
            </div>
            <p class="text-xs text-on-surface-variant">
              Habay-la-Neuve, Habay-la-Vieille, Rulles, Anlier, Marbehan et Forêt d'Anlier.
            </p>
            <div class="text-xs font-semibold text-primary">Délai estimé : 25 à 30 min</div>
          </div>

          <div class="bg-surface-container-low p-6 rounded-xl border border-outline-variant/40 space-y-3">
            <div class="flex items-center gap-2 font-bold text-primary text-base">
              <span class="material-symbols-outlined text-secondary">location_on</span>
              <span>Attert (6717)</span>
            </div>
            <p class="text-xs text-on-surface-variant">
              Vallée de l'Attert, Nobressart, Nothomb, Thiaumont, Tontelange et Post.
            </p>
            <div class="text-xs font-semibold text-primary">Délai estimé : 20 à 30 min</div>
          </div>

          <div class="bg-surface-container-low p-6 rounded-xl border border-outline-variant/40 space-y-3">
            <div class="flex items-center gap-2 font-bold text-primary text-base">
              <span class="material-symbols-outlined text-secondary">location_on</span>
              <span>Étalle & Tintigny (6740)</span>
            </div>
            <p class="text-xs text-on-surface-variant">
              Sainte-Marie, Vance, Villers-sur-Semois, Rossignol et Vallée de la Semois.
            </p>
            <div class="text-xs font-semibold text-primary">Délai estimé : 30 à 40 min</div>
          </div>

          <div class="bg-surface-container-low p-6 rounded-xl border border-outline-variant/40 space-y-3">
            <div class="flex items-center gap-2 font-bold text-primary text-base">
              <span class="material-symbols-outlined text-secondary">location_on</span>
              <span>Saint-Léger (6747)</span>
            </div>
            <p class="text-xs text-on-surface-variant">
              Châtillon, Meix-le-Tige. Plomberie sanitaire, recherche de fuite et boiler.
            </p>
            <div class="text-xs font-semibold text-primary">Délai estimé : 25 à 35 min</div>
          </div>

          <div class="bg-surface-container-low p-6 rounded-xl border border-outline-variant/40 space-y-3">
            <div class="flex items-center gap-2 font-bold text-primary text-base">
              <span class="material-symbols-outlined text-secondary">location_on</span>
              <span>Léglise (6860)</span>
            </div>
            <p class="text-xs text-on-surface-variant">
              Anlier, Mellier, Witry. Entretien chauffe-eau et canalisations en milieu rural.
            </p>
            <div class="text-xs font-semibold text-primary">Délai estimé : 35 à 45 min</div>
          </div>

          <div class="bg-surface-container-low p-6 rounded-xl border border-outline-variant/40 space-y-3">
            <div class="flex items-center gap-2 font-bold text-primary text-base">
              <span class="material-symbols-outlined text-secondary">location_on</span>
              <span>Virton (6760)</span>
            </div>
            <p class="text-xs text-on-surface-variant">
              Gaume, Saint-Mard, Ethe. Sur rendez-vous ou urgence majeure.
            </p>
            <div class="text-xs font-semibold text-primary">Délai estimé : 40 à 50 min</div>
          </div>

        </div>
      </div>

      <!-- Corridor Transfrontalier Luxembourg -->
      <div class="bg-gradient-to-br from-primary to-primary-container text-white rounded-3xl p-8 sm:p-12 shadow-xl">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
          <div class="lg:col-span-8 space-y-4">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/10 text-secondary-fixed text-xs font-bold uppercase tracking-wider">
              <span>Service Transfrontalier Belgique - Luxembourg</span>
            </div>
            <h2 class="font-headline-lg text-2xl sm:text-3xl lg:text-4xl font-extrabold tracking-tight">
              Frontaliers & Résidents au Grand-Duché : Steinfort, Capellen, Windhof
            </h2>
            <p class="text-surface-container-highest text-sm sm:text-base leading-relaxed">
              Vous habitez de l'autre côté de la frontière ou vous travaillez au Luxembourg ? Nous intervenons rapidement à <strong>Steinfort, Kleinbettingen, Capellen, Windhof et Mamer</strong>.
            </p>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-2">
              <div class="bg-white/5 border border-white/15 p-4 rounded-xl">
                <span class="font-bold text-sm block text-white mb-1">Délai Rapide</span>
                <span class="text-xs text-surface-container-highest">À 10 min de la frontière Sterpenich/Steinfort via l'E411/A6.</span>
              </div>
              <div class="bg-white/5 border border-white/15 p-4 rounded-xl">
                <span class="font-bold text-sm block text-white mb-1">Tarifs Plus Compétitifs</span>
                <span class="text-xs text-surface-container-highest">Tarifs artisans belges, très avantageux comparé aux devis luxembourgeois.</span>
              </div>
              <div class="bg-white/5 border border-white/15 p-4 rounded-xl">
                <span class="font-bold text-sm block text-white mb-1">Facturation Conforme</span>
                <span class="text-xs text-surface-container-highest">Facture officielle déductible et conforme pour vos assurances d'habitation.</span>
              </div>
            </div>
          </div>

          <div class="lg:col-span-4 bg-white text-on-surface p-6 sm:p-8 rounded-2xl shadow-lg space-y-4 text-center">
            <span class="material-symbols-outlined text-secondary text-[40px]">handshake</span>
            <h3 class="font-headline-sm text-lg font-bold text-primary">Besoin d'un Dépannage Frontière ?</h3>
            <p class="text-xs text-on-surface-variant">Nos camionnettes franchissent quotidiennement la frontière sans surcoût abusif.</p>
            <a href="tel:+32472902010" class="w-full inline-flex items-center justify-center gap-2 bg-secondary hover:bg-secondary-container text-white py-3.5 px-4 rounded-xl font-bold text-sm shadow-md transition-all">
              <span class="material-symbols-outlined text-[18px]">call</span>
              <span>0472 90 20 10</span>
            </a>
            <p class="text-[11px] text-outline">Depuis le Luxembourg : composer le +32 472 90 20 10</p>
          </div>
        </div>
      </div>

      <!-- Comparison: Local Artisan vs Brussels Brokers -->
      <div class="bg-white rounded-3xl p-8 sm:p-12 border border-outline-variant/40 shadow-sm space-y-8">
        <div class="text-center max-w-2xl mx-auto space-y-2">
          <span class="text-xs font-bold text-secondary uppercase tracking-widest">Transparence & Proximité</span>
          <h2 class="font-headline-lg text-2xl sm:text-3xl font-extrabold text-primary">
            Pourquoi Choisir un Vrai Plombier Local à Arlon ?
          </h2>
          <p class="text-on-surface-variant text-sm sm:text-base">
            Attention aux sites d'urgence sur Google qui sous-traitent à des intermédiaires basés à plus de 180 km d'Arlon.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <!-- Our Business -->
          <div class="p-6 rounded-2xl bg-emerald-50/60 border-2 border-emerald-500/40 space-y-4">
            <div class="flex items-center gap-3">
              <span class="p-2 bg-emerald-500 text-white rounded-full flex items-center justify-center">
                <span class="material-symbols-outlined text-[20px]">verified</span>
              </span>
              <div>
                <h3 class="font-bold text-base text-primary">Plombier Arlon (Artisan Local 6700)</h3>
                <span class="text-xs text-emerald-700 font-semibold">Atelier Rue des Faubourgs 14, 6700 Arlon</span>
              </div>
            </div>
            <ul class="space-y-3 text-sm text-on-surface">
              <li class="flex items-start gap-2">
                <span class="material-symbols-outlined text-emerald-600 text-[18px] shrink-0 mt-0.5">check_circle</span>
                <span><strong>Délai réel 20-30 min :</strong> camionnettes déjà en circulation dans Arlon et le Sud-Luxembourg.</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="material-symbols-outlined text-emerald-600 text-[18px] shrink-0 mt-0.5">check_circle</span>
                <span><strong>Forfait déplacement clair :</strong> dès 50 € sans mauvaise surprise kilométrique.</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="material-symbols-outlined text-emerald-600 text-[18px] shrink-0 mt-0.5">check_circle</span>
                <span><strong>Expertise calcaire arlonais :</strong> matériel adapté à la dureté extrême (+32 °fH) de notre eau.</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="material-symbols-outlined text-emerald-600 text-[18px] shrink-0 mt-0.5">check_circle</span>
                <span><strong>Numéro d'entreprise belge réel :</strong> BE 0799.456.123, agréé CSTC et compagnies d'assurances.</span>
              </li>
            </ul>
          </div>

          <!-- The Distant Platforms -->
          <div class="p-6 rounded-2xl bg-rose-50/50 border-2 border-rose-200 space-y-4">
            <div class="flex items-center gap-3">
              <span class="p-2 bg-rose-500 text-white rounded-full flex items-center justify-center">
                <span class="material-symbols-outlined text-[20px]">warning</span>
              </span>
              <div>
                <h3 class="font-bold text-base text-primary">Plateformes Call-Center (Bruxelles / Liège)</h3>
                <span class="text-xs text-rose-700 font-semibold">Intermédiaires à 150-200 km d'Arlon</span>
              </div>
            </div>
            <ul class="space-y-3 text-sm text-on-surface-variant">
              <li class="flex items-start gap-2">
                <span class="material-symbols-outlined text-rose-500 text-[18px] shrink-0 mt-0.5">cancel</span>
                <span><strong>Retard systématique :</strong> 2h à 3h de route sur la E411 avec souvent des annulations surprises.</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="material-symbols-outlined text-rose-500 text-[18px] shrink-0 mt-0.5">cancel</span>
                <span><strong>Frais de route exorbitants :</strong> facturation de 150 € à 300 € rien que pour le trajet autoroutier.</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="material-symbols-outlined text-rose-500 text-[18px] shrink-0 mt-0.5">cancel</span>
                <span><strong>Sous-traitants non vérifiés :</strong> techniciens de passage, aucune garantie de suivi SAV sur Arlon.</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="material-symbols-outlined text-rose-500 text-[18px] shrink-0 mt-0.5">cancel</span>
                <span><strong>Coordonnées opaques :</strong> adresse locale fictive ou inexistante au registre de la BCE.</span>
              </li>
            </ul>
          </div>
        </div>
      </div>

      <!-- Contact / Quote Form Section -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <div class="lg:col-span-5 space-y-6">
          <div class="inline-flex items-center gap-2 text-secondary font-bold text-xs uppercase tracking-wider">
            <span class="material-symbols-outlined text-[16px]">quick_reference</span> Devis Rapide
          </div>
          <h2 class="font-headline-lg text-2xl sm:text-3xl text-primary font-bold">
            Votre Commune est dans la Liste ?
          </h2>
          <p class="text-on-surface-variant text-sm sm:text-base leading-relaxed">
            Remplissez notre formulaire de diagnostic ou appelez directement notre standard téléphonique. Nous confirmons l'horaire de passage et le devis estimatif sans délai.
          </p>
          <div class="space-y-3 text-sm">
            <div class="flex items-center gap-3 p-3 rounded-lg bg-surface-container-low border border-outline-variant/30">
              <span class="material-symbols-outlined text-secondary">phone_in_talk</span>
              <div>
                <p class="font-bold text-primary">Ligne Directe 24/7</p>
                <a href="tel:+32472902010" class="text-secondary font-extrabold hover:underline">0472 90 20 10</a>
              </div>
            </div>
            <div class="flex items-center gap-3 p-3 rounded-lg bg-surface-container-low border border-outline-variant/30">
              <span class="material-symbols-outlined text-primary">schedule</span>
              <div>
                <p class="font-bold text-primary">Horaires d'Intervention</p>
