---
import Layout from '../../layouts/Layout.astro';
import TrustBar from '../../components/TrustBar.astro';
import QuickQuoteForm from '../../components/QuickQuoteForm.astro';
---

<Layout 
  title="Plombier Attert (6717) | Dépannage Plomberie & Adoucisseurs Vallée de l'Attert"
  description="Plombier dans la Vallée de l'Attert (6717), Nobressart, Nothomb, Thiaumont et Tontelange. Dépannage d'urgence 24/7 en 15-20 min depuis Arlon : débouchage, fuite d'eau et adoucisseurs d'eau. Tél : 0472 90 20 10."
  canonicalPath="/locations/attert"
>
  <!-- Schema.org LocalBusiness / Plumber -->
  <script type="application/ld+json" slot="head">
  {
    "@context": "https://schema.org",
    "@type": "Plumber",
    "name": "Plombier Attert - Dépannage & Sanitaire",
    "telephone": "+32472902010",
    "url": "https://plombier-arlon.be/locations/attert",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "Rue des Faubourgs 14",
      "addressLocality": "Arlon",
      "postalCode": "6700",
      "addressCountry": "BE"
    },
    "geo": {
      "@type": "GeoCoordinates",
      "latitude": 49.7508,
      "longitude": 5.7878
    },
    "areaServed": [
      {"@type": "City", "name": "Attert"},
      {"@type": "AdministrativeArea", "name": "Nobressart"},
      {"@type": "AdministrativeArea", "name": "Nothomb"},
      {"@type": "AdministrativeArea", "name": "Thiaumont"},
      {"@type": "AdministrativeArea", "name": "Tontelange"},
      {"@type": "AdministrativeArea", "name": "Post"}
    ],
    "openingHoursSpecification": [{
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday","Sunday"],
      "opens": "00:00",
      "closes": "23:59"
    }]
  }
  </script>

  <!-- Hero Section -->
  <section class="bg-primary text-white py-12 lg:py-16 border-b border-primary-container relative overflow-hidden">
    <div class="max-w-[1240px] mx-auto px-margin sm:px-margin-md space-y-5 relative z-10">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-secondary/20 text-secondary-fixed text-xs font-bold uppercase tracking-wider border border-secondary/30">
        <span class="material-symbols-outlined text-[16px]">location_on</span>
        <span>Vallée de l'Attert (6717) • Arrivée en 15 à 20 Minutes via N4</span>
      </div>
      <h1 class="font-headline-xl text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight">
        Artisan Plombier à Attert & Vallée de l'Attert : Dépannage 24/7
      </h1>
      <p class="text-surface-container-highest max-w-3xl text-base sm:text-lg leading-relaxed">
        À Attert, Nobressart (l'un des Plus Beaux Villages de Wallonie), Nothomb, Thiaumont ou Tontelange, faites confiance à notre équipe arlonaise. Dépannage plomberie express en 15 minutes, traitement de l'eau calcaire, curage écologique et recherche de fuite sans casse.
      </p>
      
      <div class="flex flex-wrap gap-4 pt-2">
        <a href="tel:+32472902010" class="inline-flex items-center gap-2 bg-secondary hover:bg-secondary-container text-white px-6 py-3.5 rounded-xl font-extrabold shadow-lg transition-all text-sm sm:text-base">
          <span class="material-symbols-outlined text-[20px]">call</span>
          <span>Urgence Attert : 0472 90 20 10</span>
        </a>
        <a href="#quote-section" class="inline-flex items-center gap-2 bg-white/10 hover:bg-white/20 text-white px-5 py-3.5 rounded-xl font-bold border border-white/20 transition-all text-sm">
          <span>Devis d'intervention sans engagement</span>
          <span class="material-symbols-outlined text-[18px]">arrow_downward</span>
        </a>
      </div>
    </div>
  </section>

  <TrustBar />

  <!-- Main Content -->
  <section class="py-16 bg-surface space-y-16">
    <div class="max-w-[1240px] mx-auto px-margin sm:px-margin-md space-y-16">

      <!-- 1. Local service area details -->
      <div class="bg-white rounded-3xl p-8 sm:p-12 border border-outline-variant/40 shadow-sm space-y-8">
        <div class="space-y-2">
          <span class="text-xs font-bold text-secondary uppercase tracking-widest">Secteur Parc Naturel (6717)</span>
          <h2 class="font-headline-lg text-2xl sm:text-3xl font-extrabold text-primary">
            Détails de Notre Périmètre de Service à Attert
          </h2>
          <p class="text-on-surface-variant text-sm sm:text-base leading-relaxed">
            Située immédiatement au Nord d'Arlon le long de l'axe N4, la commune d'Attert bénéficie d'une proximité directe avec notre atelier de la Rue des Faubourgs.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          <div class="p-5 rounded-2xl bg-surface-container-low border border-outline-variant/30 space-y-2">
            <h3 class="font-bold text-base text-primary flex items-center gap-2">
              <span class="material-symbols-outlined text-secondary text-[20px]">pin_drop</span>
              <span>Attert Centre & Administration</span>
            </h3>
            <p class="text-xs text-on-surface-variant leading-relaxed">Voie de la Liberté, quartier Maison du Parc Naturel. Dépannage fuite, plomberie de cuisine et adoucisseurs d'eau.</p>
            <span class="text-[11px] font-semibold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded-full inline-block">Délai : 15 min</span>
          </div>

          <div class="p-5 rounded-2xl bg-surface-container-low border border-outline-variant/30 space-y-2">
            <h3 class="font-bold text-base text-primary flex items-center gap-2">
              <span class="material-symbols-outlined text-secondary text-[20px]">pin_drop</span>
              <span>Nobressart</span>
            </h3>
            <p class="text-xs text-on-surface-variant leading-relaxed">Village patrimonial remarquable. Rénovation soignée de salles de bain dans les fermes ardennaises et remplacement de boilers.</p>
            <span class="text-[11px] font-semibold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded-full inline-block">Délai : 18 min</span>
          </div>

          <div class="p-5 rounded-2xl bg-surface-container-low border border-outline-variant/30 space-y-2">
            <h3 class="font-bold text-base text-primary flex items-center gap-2">
              <span class="material-symbols-outlined text-secondary text-[20px]">pin_drop</span>
              <span>Nothomb & Schadeck</span>
            </h3>
            <p class="text-xs text-on-surface-variant leading-relaxed">Vallée le long du ruisseau de la Nothomb. Curage haute pression des égouts et détection non destructive de fuites cachées.</p>
            <span class="text-[11px] font-semibold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded-full inline-block">Délai : 16 min</span>
          </div>

          <div class="p-5 rounded-2xl bg-surface-container-low border border-outline-variant/30 space-y-2">
            <h3 class="font-bold text-base text-primary flex items-center gap-2">
              <span class="material-symbols-outlined text-secondary text-[20px]">pin_drop</span>
              <span>Thiaumont & Lischert</span>
            </h3>
            <p class="text-xs text-on-surface-variant leading-relaxed">Axe N4 vers Martelange. Maisons unifamiliales et pavillons récents. Dépannage urgent de chaudière et débouchage WC.</p>
            <span class="text-[11px] font-semibold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded-full inline-block">Délai : 15 min</span>
          </div>

          <div class="p-5 rounded-2xl bg-surface-container-low border border-outline-variant/30 space-y-2">
            <h3 class="font-bold text-base text-primary flex items-center gap-2">
              <span class="material-symbols-outlined text-secondary text-[20px]">pin_drop</span>
              <span>Tontelange & Metzert</span>
            </h3>
            <p class="text-xs text-on-surface-variant leading-relaxed">Zone frontalière immédiate avec le Grand-Duché (Beckerich / Ell). Entretien régulier des installations sanitaires de frontaliers.</p>
            <span class="text-[11px] font-semibold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded-full inline-block">Délai : 18 min</span>
          </div>

          <div class="p-5 rounded-2xl bg-surface-container-low border border-outline-variant/30 space-y-2">
            <h3 class="font-bold text-base text-primary flex items-center gap-2">
              <span class="material-symbols-outlined text-secondary text-[20px]">water_drop</span>
              <span>Préservation Environnementale</span>
            </h3>
            <p class="text-xs text-on-surface-variant leading-relaxed">Parc Naturel : utilisation exclusive d'hydrocurage mécanique haute pression, sans rejet d'acides ni produits chimiques nocifs.</p>
            <span class="text-[11px] font-semibold text-primary bg-primary/10 px-2 py-0.5 rounded-full inline-block">Écologique 100%</span>
          </div>
        </div>
      </div>

      <!-- 2. Driving directions from major landmarks -->
      <div class="space-y-8">
        <div class="space-y-2">
          <span class="text-xs font-bold text-primary uppercase tracking-widest">Itinéraires d'Accès</span>
          <h2 class="font-headline-lg text-2xl sm:text-3xl font-extrabold text-primary">
            Itinéraires d'Accès Rapide à Attert Depuis les Points de Repère
          </h2>
          <p class="text-on-surface-variant text-sm sm:text-base leading-relaxed">
            Grâce à la route nationale N4 et à la proximité d'Arlon Nord, l'accès est direct et sans bouchon :
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="bg-white p-6 rounded-2xl border border-outline-variant/40 shadow-sm space-y-3">
            <div class="flex items-center justify-between">
              <span class="font-bold text-base text-primary">Depuis la N4 / Arlon Nord</span>
              <span class="text-xs bg-emerald-100 text-emerald-800 font-bold px-2 py-0.5 rounded-full">12 min</span>
            </div>
            <p class="text-xs text-on-surface-variant leading-relaxed">
              Via la <strong>Route de Bastogne (N4)</strong> en sortant d'Arlon par Schoppach. Arrivée directe à la bifurcation d'Attert / Post en moins de 12 minutes.
            </p>
            <p class="text-[11px] text-outline">Distance : 10 km • Axe principal rapide à double voie.</p>
          </div>

          <div class="bg-white p-6 rounded-2xl border border-outline-variant/40 shadow-sm space-y-3">
            <div class="flex items-center justify-between">
              <span class="font-bold text-base text-primary">Depuis l'Église de Nobressart</span>
              <span class="text-xs bg-emerald-100 text-emerald-800 font-bold px-2 py-0.5 rounded-full">18 min</span>
            </div>
            <p class="text-xs text-on-surface-variant leading-relaxed">
              Accès par <strong>Heinsch et Thiaumont</strong> pour atteindre directement le coeur du village de Nobressart et ses fermettes rénovées.
            </p>
            <p class="text-[11px] text-outline">Distance : 13 km • Matériel de plomberie et pièces à bord.</p>
          </div>

          <div class="bg-white p-6 rounded-2xl border border-outline-variant/40 shadow-sm space-y-3">
            <div class="flex items-center justify-between">
              <span class="font-bold text-base text-primary">Depuis Tontelange / Frontière</span>
              <span class="text-xs bg-emerald-100 text-emerald-800 font-bold px-2 py-0.5 rounded-full">16 min</span>
            </div>
            <p class="text-xs text-on-surface-variant leading-relaxed">
              Via <strong>Bonnert et la route de Frassem (N882)</strong>. Jonction directe avec Tontelange sans repasser par la nationale N4.
            </p>
            <p class="text-[11px] text-outline">Distance : 11 km • Trajet idéal pour interventions transfrontalières.</p>
          </div>
        </div>
      </div>

      <!-- 3. Neighborhood-specific content -->
      <div class="bg-surface-container-low rounded-3xl p-8 sm:p-12 border border-outline-variant/40 space-y-8">
        <div class="space-y-2">
          <span class="text-xs font-bold text-secondary uppercase tracking-widest">Écologie & Patrimoine</span>
          <h2 class="font-headline-lg text-2xl sm:text-3xl font-extrabold text-primary">
            Spécificités Plomberie dans le Parc Naturel de la Vallée de l'Attert
          </h2>
          <p class="text-on-surface-variant text-sm sm:text-base leading-relaxed">
            La zone naturelle protégée d'Attert impose des exigences strictes en matière d'assainissement et de respect de l'eau :
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          <div class="bg-white p-6 rounded-2xl border border-outline-variant/30 space-y-3">
            <h3 class="font-bold text-base text-primary flex items-center gap-2">
              <span class="material-symbols-outlined text-secondary">eco</span>
              <span>Systèmes d'Assainissement Individuel & Écologique</span>
            </h3>
            <p class="text-xs text-on-surface-variant leading-relaxed">
              De nombreuses habitations de la vallée disposent de micro-stations d'épuration ou de lagunages individuels. <strong>Notre engagement :</strong> nous intervenons pour le débouchage et l'inspection caméra de ces réseaux sans aucun solvant ni produit chimique afin de préserver l'équilibre biologique des filtres et cours d'eau.
            </p>
          </div>

          <div class="bg-white p-6 rounded-2xl border border-outline-variant/30 space-y-3">
            <h3 class="font-bold text-base text-primary flex items-center gap-2">
              <span class="material-symbols-outlined text-secondary">house</span>
              <span>Bâtisses Traditionnelles & Fermes Rénovées</span>
            </h3>
            <p class="text-xs text-on-surface-variant leading-relaxed">
              Maisons en grès liasique avec murs épais. <strong>Interventions courantes :</strong> recherche non destructive de fuite encastrée par caméra thermique FLIR (évitant d'abîmer les murs de pierre) et pose d'adoucisseurs d'eau pour protéger les installations sanitaires récentes de la dureté de l'eau calcaire.
            </p>
          </div>
        </div>
      </div>

      <!-- 4. Local competitor comparison -->
      <div class="bg-white rounded-3xl p-8 sm:p-12 border border-outline-variant/40 shadow-sm space-y-8">
        <div class="text-center max-w-2xl mx-auto space-y-2">
          <span class="text-xs font-bold text-secondary uppercase tracking-widest">Comparatif Local</span>
          <h2 class="font-headline-lg text-2xl sm:text-3xl font-extrabold text-primary">
            Artisan de la Région vs Centrales d'Urgence à Attert
          </h2>
          <p class="text-on-surface-variant text-sm sm:text-base">
            Pourquoi faire appel à notre atelier d'Arlon plutôt qu'à une régie nationale :
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <div class="p-6 rounded-2xl bg-emerald-50/60 border-2 border-emerald-500/40 space-y-4">
            <div class="flex items-center gap-3">
              <span class="p-2 bg-emerald-500 text-white rounded-full flex items-center justify-center">
                <span class="material-symbols-outlined text-[20px]">verified</span>
              </span>
              <div>
                <h3 class="font-bold text-base text-primary">Plombier Arlon (Pour Attert)</h3>
                <span class="text-xs text-emerald-700 font-semibold">Atelier à 10 km (Rue des Faubourgs 14)</span>
              </div>
            </div>
            <ul class="space-y-3 text-xs sm:text-sm text-on-surface">
              <li class="flex items-start gap-2">
                <span class="material-symbols-outlined text-emerald-600 text-[18px] shrink-0 mt-0.5">check_circle</span>
                <span><strong>Arrivée en 15 à 20 min :</strong> Sortie Nord immédiate par la N4.</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="material-symbols-outlined text-emerald-600 text-[18px] shrink-0 mt-0.5">check_circle</span>
                <span><strong>Méthodes écologiques :</strong> Conformes aux règles du Parc Naturel.</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="material-symbols-outlined text-emerald-600 text-[18px] shrink-0 mt-0.5">check_circle</span>
                <span><strong>Numéro d'entreprise belge vérifié :</strong> BE 0799.456.123 et agrément CSTC.</span>
              </li>
            </ul>
          </div>

          <div class="p-6 rounded-2xl bg-rose-50/50 border-2 border-rose-200 space-y-4">
            <div class="flex items-center gap-3">
              <span class="p-2 bg-rose-500 text-white rounded-full flex items-center justify-center">
                <span class="material-symbols-outlined text-[20px]">warning</span>
              </span>
              <div>
                <h3 class="font-bold text-base text-primary">Sites Internet de Call-Center</h3>
                <span class="text-xs text-rose-700 font-semibold">Bureaux à Bruxelles ou Liège (170 km)</span>
              </div>
            </div>
            <ul class="space-y-3 text-xs sm:text-sm text-on-surface-variant">
              <li class="flex items-start gap-2">
                <span class="material-symbols-outlined text-rose-500 text-[18px] shrink-0 mt-0.5">cancel</span>
                <span><strong>Délais interminables :</strong> Jusqu'à 3h d'attente pour une urgence inondation.</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="material-symbols-outlined text-rose-500 text-[18px] shrink-0 mt-0.5">cancel</span>
                <span><strong>Frais kilométriques déraisonnables :</strong> 150 à 250 € ajoutés à la facture.</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="material-symbols-outlined text-rose-500 text-[18px] shrink-0 mt-0.5">cancel</span>
                <span><strong>Sous-traitance opaque :</strong> Aucun artisan référencé localement.</span>
              </li>
            </ul>
          </div>
        </div>
      </div>

      <!-- Quick Emergency Call Banner -->
      <div class="bg-gradient-to-r from-primary to-primary-container text-white rounded-3xl p-8 sm:p-10 shadow-xl flex flex-col md:flex-row items-center justify-between gap-6">
        <div class="space-y-2 text-center md:text-left">
          <span class="text-xs font-bold text-secondary-fixed uppercase tracking-wider">Intervention Rapide à Attert</span>
          <h3 class="font-headline-md text-2xl font-bold">Besoin d'un dépannage plomberie dans la Vallée de l'Attert ?</h3>
          <p class="text-surface-container-highest text-sm">Appelez notre standard d'astreinte local : nous arrivons sous 15 minutes.</p>
        </div>
        <a href="tel:+32472902010" class="inline-flex items-center justify-center gap-2 bg-secondary hover:bg-secondary-container text-white py-3.5 px-6 rounded-xl font-extrabold text-sm shadow-md transition-all shrink-0">
          <span class="material-symbols-outlined text-[20px]">call</span>
          <span>0472 90 20 10</span>
        </a>
      </div>

      <!-- Quote form -->
      <div id="quote-section">
        <QuickQuoteForm />
      </div>

    </div>
  </section>
</Layout>
