---
import Layout from '../../layouts/Layout.astro';
import TrustBar from '../../components/TrustBar.astro';
import QuickQuoteForm from '../../components/QuickQuoteForm.astro';
---

<Layout 
  title="Plombier Athus & Aubange (6790) | Dépannage Urgence 24/7 & Débouchage en 25 Min"
  description="Plombier à Athus, Aubange (6790), Halanzy et Rachecourt. Dépannage d'urgence 24h/24 en 25 min depuis Arlon : débouchage WC, recherche de fuite d'eau et remplacement boiler. Tél : 0472 90 20 10."
  canonicalPath="/locations/aubange-athus"
>
  <!-- Schema.org LocalBusiness / Plumber -->
  <script type="application/ld+json" slot="head">
  {
    "@context": "https://schema.org",
    "@type": "Plumber",
    "name": "Plombier Athus & Aubange - Dépannage d'Urgence",
    "telephone": "+32472902010",
    "url": "https://plombier-arlon.be/locations/aubange-athus",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "Rue des Faubourgs 14",
      "addressLocality": "Arlon",
      "postalCode": "6700",
      "addressCountry": "BE"
    },
    "geo": {
      "@type": "GeoCoordinates",
      "latitude": 49.5639,
      "longitude": 5.8361
    },
    "areaServed": [
      {"@type": "City", "name": "Athus"},
      {"@type": "City", "name": "Aubange"},
      {"@type": "AdministrativeArea", "name": "Halanzy"},
      {"@type": "AdministrativeArea", "name": "Rachecourt"},
      {"@type": "AdministrativeArea", "name": "Battincourt"}
    ],
    "openingHoursSpecification": [{
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday","Sunday"],
      "opens": "00:00",
      "closes": "23:59"
    }]
  }
  </script>

  <!-- Hero Section -->
  <section class="bg-primary text-white py-12 lg:py-16 border-b border-primary-container relative overflow-hidden">
    <div class="max-w-[1240px] mx-auto px-margin sm:px-margin-md space-y-5 relative z-10">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-secondary/20 text-secondary-fixed text-xs font-bold uppercase tracking-wider border border-secondary/30">
        <span class="material-symbols-outlined text-[16px]">location_on</span>
        <span>Athus, Aubange & Halanzy (6790) • Arrivée en 20 à 25 Minutes</span>
      </div>
      <h1 class="font-headline-xl text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight">
        Artisan Plombier à Athus & Aubange : Dépannage 24/7
      </h1>
      <p class="text-surface-container-highest max-w-3xl text-base sm:text-lg leading-relaxed">
        Au carrefour des trois frontières (Belgique, Luxembourg, France), nous assurons des interventions rapides en plomberie sanitaire, recherche de fuite et débouchage canalisation pour les particuliers et gestionnaires d'immeubles d'Athus, Aubange, Halanzy et Rachecourt.
      </p>
      
      <div class="flex flex-wrap gap-4 pt-2">
        <a href="tel:+32472902010" class="inline-flex items-center gap-2 bg-secondary hover:bg-secondary-container text-white px-6 py-3.5 rounded-xl font-extrabold shadow-lg transition-all text-sm sm:text-base">
          <span class="material-symbols-outlined text-[20px]">call</span>
          <span>Urgence Athus / Aubange : 0472 90 20 10</span>
        </a>
        <a href="#quote-section" class="inline-flex items-center gap-2 bg-white/10 hover:bg-white/20 text-white px-5 py-3.5 rounded-xl font-bold border border-white/20 transition-all text-sm">
          <span>Devis express sans engagement</span>
          <span class="material-symbols-outlined text-[18px]">arrow_downward</span>
        </a>
      </div>
    </div>
  </section>

  <TrustBar />

  <!-- Main Content -->
  <section class="py-16 bg-surface space-y-16">
    <div class="max-w-[1240px] mx-auto px-margin sm:px-margin-md space-y-16">

      <!-- 1. Local service area details -->
      <div class="bg-white rounded-3xl p-8 sm:p-12 border border-outline-variant/40 shadow-sm space-y-8">
        <div class="space-y-2">
          <span class="text-xs font-bold text-secondary uppercase tracking-widest">Couverture Entité d'Aubange (6790 / 6791)</span>
          <h2 class="font-headline-lg text-2xl sm:text-3xl font-extrabold text-primary">
            Détails de Notre Zone de Service à Athus, Aubange & Environs
          </h2>
          <p class="text-on-surface-variant text-sm sm:text-base leading-relaxed">
            Grâce à l'axe N81 direct depuis Arlon, nos techniciens se déploient immédiatement sur l'ensemble du bassin frontalier d'Aubange.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          <div class="p-5 rounded-2xl bg-surface-container-low border border-outline-variant/30 space-y-2">
            <h3 class="font-bold text-base text-primary flex items-center gap-2">
              <span class="material-symbols-outlined text-secondary text-[20px]">pin_drop</span>
              <span>Athus Centre & Pôle Européen (PED)</span>
            </h3>
            <p class="text-xs text-on-surface-variant leading-relaxed">Grand-Rue, Rue de Rodange, Rue de France, Terminal Container. Copropriétés, commerces et logements ouvriers rénovés.</p>
            <span class="text-[11px] font-semibold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded-full inline-block">Délai : 20-25 min</span>
          </div>

          <div class="p-5 rounded-2xl bg-surface-container-low border border-outline-variant/30 space-y-2">
            <h3 class="font-bold text-base text-primary flex items-center gap-2">
              <span class="material-symbols-outlined text-secondary text-[20px]">pin_drop</span>
              <span>Aubange Ville</span>
            </h3>
            <p class="text-xs text-on-surface-variant leading-relaxed">Rue du Village, Rue de Messancy, quartier Hôtel de Ville. Maisons individuelles, dépannage boiler et rénovation salle de bain.</p>
            <span class="text-[11px] font-semibold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded-full inline-block">Délai : 20 min</span>
          </div>

          <div class="p-5 rounded-2xl bg-surface-container-low border border-outline-variant/30 space-y-2">
            <h3 class="font-bold text-base text-primary flex items-center gap-2">
              <span class="material-symbols-outlined text-secondary text-[20px]">pin_drop</span>
              <span>Halanzy & Musson</span>
            </h3>
            <p class="text-xs text-on-surface-variant leading-relaxed">Axe N88 vers Virton. Lotissements pavillonnaires et maisons traditionnelles en pierre de Gaume. Débouchage et adoucisseurs.</p>
            <span class="text-[11px] font-semibold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded-full inline-block">Délai : 25 min</span>
          </div>

          <div class="p-5 rounded-2xl bg-surface-container-low border border-outline-variant/30 space-y-2">
            <h3 class="font-bold text-base text-primary flex items-center gap-2">
              <span class="material-symbols-outlined text-secondary text-[20px]">pin_drop</span>
              <span>Rachecourt & Battincourt</span>
            </h3>
            <p class="text-xs text-on-surface-variant leading-relaxed">Zones vallonnées pittoresques. Entretien de chaudières, curage haute pression de canalisations et traitement du calcaire.</p>
            <span class="text-[11px] font-semibold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded-full inline-block">Délai : 25 min</span>
          </div>

          <div class="p-5 rounded-2xl bg-surface-container-low border border-outline-variant/30 space-y-2">
            <h3 class="font-bold text-base text-primary flex items-center gap-2">
              <span class="material-symbols-outlined text-secondary text-[20px]">pin_drop</span>
              <span>Frontière Rodange / Pétange</span>
            </h3>
            <p class="text-xs text-on-surface-variant leading-relaxed">Interventions régulières pour les travailleurs frontaliers habitant à quelques centaines de mètres de la douane luxembourgeoise.</p>
            <span class="text-[11px] font-semibold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded-full inline-block">Délai : 25 min</span>
          </div>

          <div class="p-5 rounded-2xl bg-surface-container-low border border-outline-variant/30 space-y-2">
            <h3 class="font-bold text-base text-primary flex items-center gap-2">
              <span class="material-symbols-outlined text-secondary text-[20px]">water_drop</span>
              <span>Dureté de l'Eau à Athus (+30 °fH)</span>
            </h3>
            <p class="text-xs text-on-surface-variant leading-relaxed">Réseau d'eau fortement minéralisé. Risque élevé d'entartrage précoce des chauffe-eau et appareils électroménagers.</p>
            <span class="text-[11px] font-semibold text-primary bg-primary/10 px-2 py-0.5 rounded-full inline-block">Pose adoucisseur BWT</span>
          </div>
        </div>
      </div>

      <!-- 2. Driving directions from major landmarks -->
      <div class="space-y-8">
        <div class="space-y-2">
          <span class="text-xs font-bold text-primary uppercase tracking-widest">Itinéraires Clés</span>
          <h2 class="font-headline-lg text-2xl sm:text-3xl font-extrabold text-primary">
            Itinéraires d'Accès Rapide Depuis les Grands Repères
          </h2>
          <p class="text-on-surface-variant text-sm sm:text-base leading-relaxed">
            Notre atelier arlonais (Rue des Faubourgs) permet une descente fluide vers le Sud :
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="bg-white p-6 rounded-2xl border border-outline-variant/40 shadow-sm space-y-3">
            <div class="flex items-center justify-between">
              <span class="font-bold text-base text-primary">Depuis la N81 / Pôle Européen</span>
              <span class="text-xs bg-emerald-100 text-emerald-800 font-bold px-2 py-0.5 rounded-full">20 min</span>
            </div>
            <p class="text-xs text-on-surface-variant leading-relaxed">
              Descente directe via la <strong>N81 Express 4 voies</strong> en dépassant Messancy. Arrivée directe sur le contournement d'Athus et la zone industrielle du PED.
            </p>
            <p class="text-[11px] text-outline">Distance : 15 km • Trajet le plus rapide en urgence.</p>
          </div>

          <div class="bg-white p-6 rounded-2xl border border-outline-variant/40 shadow-sm space-y-3">
            <div class="flex items-center justify-between">
              <span class="font-bold text-base text-primary">Depuis la Gare Internationale d'Athus</span>
              <span class="text-xs bg-emerald-100 text-emerald-800 font-bold px-2 py-0.5 rounded-full">22 min</span>
            </div>
            <p class="text-xs text-on-surface-variant leading-relaxed">
              Accès via la Rue de Guerlange ou l'avenue de l'Europe. Accès immédiat aux résidences d'appartements et immeubles collectifs du centre-ville d'Athus.
            </p>
            <p class="text-[11px] text-outline">Distance : 16 km • Intervention d'urgence jour & nuit.</p>
          </div>

          <div class="bg-white p-6 rounded-2xl border border-outline-variant/40 shadow-sm space-y-3">
            <div class="flex items-center justify-between">
              <span class="font-bold text-base text-primary">Depuis Halanzy / Rachecourt</span>
              <span class="text-xs bg-emerald-100 text-emerald-800 font-bold px-2 py-0.5 rounded-full">25 min</span>
            </div>
            <p class="text-xs text-on-surface-variant leading-relaxed">
              Via la <strong>N883 par Wolkrange ou par Aubange centre</strong> pour atteindre le vallon d'Halanzy et les coteaux de Rachecourt sans encombre.
            </p>
            <p class="text-[11px] text-outline">Distance : 18 km • Matériel de débouchage embarqué.</p>
          </div>
        </div>
      </div>

      <!-- 3. Neighborhood-specific content -->
      <div class="bg-surface-container-low rounded-3xl p-8 sm:p-12 border border-outline-variant/40 space-y-8">
        <div class="space-y-2">
          <span class="text-xs font-bold text-secondary uppercase tracking-widest">Réalités de Terrain</span>
          <h2 class="font-headline-lg text-2xl sm:text-3xl font-extrabold text-primary">
            Spécificités Techniques de la Plomberie à Athus & Aubange
          </h2>
          <p class="text-on-surface-variant text-sm sm:text-base leading-relaxed">
            Le parc immobilier de l'entité d'Aubange présente des défis techniques très particuliers :
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          <div class="bg-white p-6 rounded-2xl border border-outline-variant/30 space-y-3">
            <h3 class="font-bold text-base text-primary flex items-center gap-2">
              <span class="material-symbols-outlined text-secondary">apartment</span>
              <span>Immeubles Collectifs & Résidences Récentes à Athus</span>
            </h3>
            <p class="text-xs text-on-surface-variant leading-relaxed">
              En raison de la proximité du Luxembourg, Athus compte de nombreux immeubles à appartements. <strong>Pannes fréquentes :</strong> colonnes générales d'eaux usées bouchées par des lingettes, fuites d'eau encastrées sous les chapes nécessitant une détection acoustique/infrarouge sans destruction pour le syndic, et réducteurs de pression défaillants.
            </p>
          </div>

          <div class="bg-white p-6 rounded-2xl border border-outline-variant/30 space-y-3">
            <h3 class="font-bold text-base text-primary flex items-center gap-2">
              <span class="material-symbols-outlined text-secondary">house</span>
              <span>Maisons Ouvrières & Pavillons Familiaux à Aubange / Halanzy</span>
            </h3>
            <p class="text-xs text-on-surface-variant leading-relaxed">
              Habitations traditionnelles avec extensions successives. <strong>Besoins réguliers :</strong> remplacement d'anciens chauffe-eau énergivores par des boilers thermodynamiques, mise en conformité des conduites d'alimentation et pose de WC suspendus Geberit en remplacement d'anciennes cuvettes au sol.
            </p>
          </div>
        </div>
      </div>

      <!-- 4. Local competitor comparison -->
      <div class="bg-white rounded-3xl p-8 sm:p-12 border border-outline-variant/40 shadow-sm space-y-8">
        <div class="text-center max-w-2xl mx-auto space-y-2">
          <span class="text-xs font-bold text-secondary uppercase tracking-widest">Comparatif de Service</span>
          <h2 class="font-headline-lg text-2xl sm:text-3xl font-extrabold text-primary">
            Pourquoi Choisir Plombier Arlon à Athus & Aubange ?
          </h2>
          <p class="text-on-surface-variant text-sm sm:text-base">
            Évitez les déconvenues avec les plates-formes Internet de mise en relation basées loin de notre province :
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <div class="p-6 rounded-2xl bg-emerald-50/60 border-2 border-emerald-500/40 space-y-4">
            <div class="flex items-center gap-3">
              <span class="p-2 bg-emerald-500 text-white rounded-full flex items-center justify-center">
                <span class="material-symbols-outlined text-[20px]">verified</span>
              </span>
              <div>
                <h3 class="font-bold text-base text-primary">Plombier Arlon (Pour Athus & Aubange)</h3>
                <span class="text-xs text-emerald-700 font-semibold">Artisan basé à Arlon (16 km)</span>
              </div>
            </div>
            <ul class="space-y-3 text-xs sm:text-sm text-on-surface">
              <li class="flex items-start gap-2">
                <span class="material-symbols-outlined text-emerald-600 text-[18px] shrink-0 mt-0.5">check_circle</span>
                <span><strong>Intervention garantie en 25 min :</strong> Pas de traversée de toute la Wallonie.</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="material-symbols-outlined text-emerald-600 text-[18px] shrink-0 mt-0.5">check_circle</span>
                <span><strong>Factures transparentes & agréées :</strong> Conformes aux compagnies d'assurances belges.</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="material-symbols-outlined text-emerald-600 text-[18px] shrink-0 mt-0.5">check_circle</span>
                <span><strong>Hydrocureuse haute pression 200 bars :</strong> Débouchage radical sans chimie.</span>
              </li>
            </ul>
          </div>

          <div class="p-6 rounded-2xl bg-rose-50/50 border-2 border-rose-200 space-y-4">
            <div class="flex items-center gap-3">
              <span class="p-2 bg-rose-500 text-white rounded-full flex items-center justify-center">
                <span class="material-symbols-outlined text-[20px]">warning</span>
              </span>
              <div>
                <h3 class="font-bold text-base text-primary">Centrales de Dépannage Liège / Bruxelles</h3>
                <span class="text-xs text-rose-700 font-semibold">Sous-traitants à 180 km</span>
              </div>
            </div>
            <ul class="space-y-3 text-xs sm:text-sm text-on-surface-variant">
              <li class="flex items-start gap-2">
                <span class="material-symbols-outlined text-rose-500 text-[18px] shrink-0 mt-0.5">cancel</span>
                <span><strong>2h30 à 3h de route :</strong> Délais imprévisibles et rendez-vous annulés.</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="material-symbols-outlined text-rose-500 text-[18px] shrink-0 mt-0.5">cancel</span>
                <span><strong>Facturation kilométrique démesurée :</strong> 180 à 250 € de frais de déplacement.</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="material-symbols-outlined text-rose-500 text-[18px] shrink-0 mt-0.5">cancel</span>
                <span><strong>Aucun suivi de garantie :</strong> Impossibilité d'obtenir un technicien pour le SAV.</span>
              </li>
            </ul>
          </div>
        </div>
      </div>

      <!-- Quick Emergency Call Banner -->
      <div class="bg-gradient-to-r from-primary to-primary-container text-white rounded-3xl p-8 sm:p-10 shadow-xl flex flex-col md:flex-row items-center justify-between gap-6">
        <div class="space-y-2 text-center md:text-left">
          <span class="text-xs font-bold text-secondary-fixed uppercase tracking-wider">Urgence Plomberie à Athus & Aubange</span>
          <h3 class="font-headline-md text-2xl font-bold">Un WC qui déborde ou une fuite d'eau à Athus ?</h3>
          <p class="text-surface-container-highest text-sm">Notre technicien d'astreinte intervient jour et nuit en moins de 25 minutes.</p>
        </div>
        <a href="tel:+32472902010" class="inline-flex items-center justify-center gap-2 bg-secondary hover:bg-secondary-container text-white py-3.5 px-6 rounded-xl font-extrabold text-sm shadow-md transition-all shrink-0">
          <span class="material-symbols-outlined text-[20px]">call</span>
          <span>0472 90 20 10</span>
        </a>
      </div>

      <!-- Quote form -->
      <div id="quote-section">
        <QuickQuoteForm />
      </div>

    </div>
  </section>
</Layout>
