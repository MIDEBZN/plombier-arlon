---
import Layout from '../../layouts/Layout.astro';
import TrustBar from '../../components/TrustBar.astro';
import QuickQuoteForm from '../../components/QuickQuoteForm.astro';
---

<Layout 
  title="Plombier Habay (6720) | Dépannage Plomberie & Chauffage en 20-25 Min"
  description="Plombier à Habay (6720), Habay-la-Neuve, Marbehan, Anlier et Rulles. Dépannage express en 20 min depuis Arlon : recherche de fuite d'eau, curage fosse septique, débouchage et boiler. Tél : 0472 90 20 10."
  canonicalPath="/locations/habay"
>
  <!-- Schema.org LocalBusiness / Plumber -->
  <script type="application/ld+json" slot="head">
  {
    "@context": "https://schema.org",
    "@type": "Plumber",
    "name": "Plombier Habay - Dépannage d'Urgence",
    "telephone": "+32472902010",
    "url": "https://plombier-arlon.be/locations/habay",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "Rue des Faubourgs 14",
      "addressLocality": "Arlon",
      "postalCode": "6700",
      "addressCountry": "BE"
    },
    "geo": {
      "@type": "GeoCoordinates",
      "latitude": 49.7303,
      "longitude": 5.6517
    },
    "areaServed": [
      {"@type": "City", "name": "Habay-la-Neuve"},
      {"@type": "AdministrativeArea", "name": "Habay-la-Vieille"},
      {"@type": "AdministrativeArea", "name": "Marbehan"},
      {"@type": "AdministrativeArea", "name": "Anlier"},
      {"@type": "AdministrativeArea", "name": "Rulles"},
      {"@type": "AdministrativeArea", "name": "Houdemont"}
    ],
    "openingHoursSpecification": [{
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday","Sunday"],
      "opens": "00:00",
      "closes": "23:59"
    }]
  }
  </script>

  <!-- Hero Section -->
  <section class="bg-primary text-white py-12 lg:py-16 border-b border-primary-container relative overflow-hidden">
    <div class="max-w-[1240px] mx-auto px-margin sm:px-margin-md space-y-5 relative z-10">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-secondary/20 text-secondary-fixed text-xs font-bold uppercase tracking-wider border border-secondary/30">
        <span class="material-symbols-outlined text-[16px]">location_on</span>
        <span>Commune de Habay (6720) • Arrivée en 20 à 25 Minutes via E411</span>
      </div>
      <h1 class="font-headline-xl text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight">
        Artisan Plombier à Habay : Dépannage 24/7 & Chauffage
      </h1>
      <p class="text-surface-container-highest max-w-3xl text-base sm:text-lg leading-relaxed">
        À Habay-la-Neuve, Habay-la-Vieille, Marbehan, Rulles ou Anlier, bénéficiez de l'intervention rapide de nos artisans plombiers et chauffagistes. Dépannage d'urgence sous 25 minutes, débouchage haute pression et entretien de chaudières agréé Région Wallonne.
      </p>
      
      <div class="flex flex-wrap gap-4 pt-2">
        <a href="tel:+32472902010" class="inline-flex items-center gap-2 bg-secondary hover:bg-secondary-container text-white px-6 py-3.5 rounded-xl font-extrabold shadow-lg transition-all text-sm sm:text-base">
          <span class="material-symbols-outlined text-[20px]">call</span>
          <span>Urgence Habay : 0472 90 20 10</span>
        </a>
        <a href="#quote-section" class="inline-flex items-center gap-2 bg-white/10 hover:bg-white/20 text-white px-5 py-3.5 rounded-xl font-bold border border-white/20 transition-all text-sm">
          <span>Devis d'intervention gratuit</span>
          <span class="material-symbols-outlined text-[18px]">arrow_downward</span>
        </a>
      </div>
    </div>
  </section>

  <TrustBar />

  <!-- Main Content -->
  <section class="py-16 bg-surface space-y-16">
    <div class="max-w-[1240px] mx-auto px-margin sm:px-margin-md space-y-16">

      <!-- 1. Local service area details -->
      <div class="bg-white rounded-3xl p-8 sm:p-12 border border-outline-variant/40 shadow-sm space-y-8">
        <div class="space-y-2">
          <span class="text-xs font-bold text-secondary uppercase tracking-widest">Secteur Habay & Forêt d'Anlier (6720)</span>
          <h2 class="font-headline-lg text-2xl sm:text-3xl font-extrabold text-primary">
            Détails de Notre Périmètre de Service à Habay
          </h2>
          <p class="text-on-surface-variant text-sm sm:text-base leading-relaxed">
            Grâce à l'autoroute E411 (Sortie 29), notre atelier arlonais est à seulement 15 km de Habay, permettant une intervention sans aucun retard.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          <div class="p-5 rounded-2xl bg-surface-container-low border border-outline-variant/30 space-y-2">
            <h3 class="font-bold text-base text-primary flex items-center gap-2">
              <span class="material-symbols-outlined text-secondary text-[20px]">pin_drop</span>
              <span>Habay-la-Neuve (Centre)</span>
            </h3>
            <p class="text-xs text-on-surface-variant leading-relaxed">Rue de Luxembourg, Place Pierre Nothomb, zone résidentielle et commerces. Dépannage fuites, WC et sanitaires.</p>
            <span class="text-[11px] font-semibold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded-full inline-block">Délai : 20 min</span>
          </div>

          <div class="p-5 rounded-2xl bg-surface-container-low border border-outline-variant/30 space-y-2">
            <h3 class="font-bold text-base text-primary flex items-center gap-2">
              <span class="material-symbols-outlined text-secondary text-[20px]">pin_drop</span>
              <span>Habay-la-Vieille</span>
            </h3>
            <p class="text-xs text-on-surface-variant leading-relaxed">Quartiers résidentiels calmes et pavillons récents. Remplacement de boilers entartrés et rénovation de douches italiennes.</p>
            <span class="text-[11px] font-semibold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded-full inline-block">Délai : 20-22 min</span>
          </div>

          <div class="p-5 rounded-2xl bg-surface-container-low border border-outline-variant/30 space-y-2">
            <h3 class="font-bold text-base text-primary flex items-center gap-2">
              <span class="material-symbols-outlined text-secondary text-[20px]">pin_drop</span>
              <span>Marbehan (Gare & Village)</span>
            </h3>
            <p class="text-xs text-on-surface-variant leading-relaxed">Axe ferroviaire Arlon-Namur. Maisons unifamiliales, dépannage chaudières mazout et désobstruction de colonnes d'eaux usées.</p>
            <span class="text-[11px] font-semibold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded-full inline-block">Délai : 25 min</span>
          </div>

          <div class="p-5 rounded-2xl bg-surface-container-low border border-outline-variant/30 space-y-2">
            <h3 class="font-bold text-base text-primary flex items-center gap-2">
              <span class="material-symbols-outlined text-secondary text-[20px]">pin_drop</span>
              <span>Anlier & Forêt d'Anlier</span>
            </h3>
            <p class="text-xs text-on-surface-variant leading-relaxed">Secteur forestier ardennais. Dégel thermique de tuyauteries en hiver, entretien de fosses septiques et curage haute pression.</p>
            <span class="text-[11px] font-semibold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded-full inline-block">Délai : 25 min</span>
          </div>

          <div class="p-5 rounded-2xl bg-surface-container-low border border-outline-variant/30 space-y-2">
            <h3 class="font-bold text-base text-primary flex items-center gap-2">
              <span class="material-symbols-outlined text-secondary text-[20px]">pin_drop</span>
              <span>Rulles & Houdemont</span>
            </h3>
            <p class="text-xs text-on-surface-variant leading-relaxed">Vallée de la Rulles. Détection de fuites cachées par thermographie infrarouge et désembouage de radiateurs anciens.</p>
            <span class="text-[11px] font-semibold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded-full inline-block">Délai : 25 min</span>
          </div>

          <div class="p-5 rounded-2xl bg-surface-container-low border border-outline-variant/30 space-y-2">
            <h3 class="font-bold text-base text-primary flex items-center gap-2">
              <span class="material-symbols-outlined text-secondary text-[20px]">water_drop</span>
              <span>Eau Calcaire & Risques de Gel</span>
            </h3>
            <p class="text-xs text-on-surface-variant leading-relaxed">Climat plus rigoureux en lisière de forêt : risque élevé de tuyaux éclatés lors des nuits glaciales d'hiver ardennais.</p>
            <span class="text-[11px] font-semibold text-primary bg-primary/10 px-2 py-0.5 rounded-full inline-block">Dégel express sécurisé</span>
          </div>
        </div>
      </div>

      <!-- 2. Driving directions from major landmarks -->
      <div class="space-y-8">
        <div class="space-y-2">
          <span class="text-xs font-bold text-primary uppercase tracking-widest">Temps de Trajet</span>
          <h2 class="font-headline-lg text-2xl sm:text-3xl font-extrabold text-primary">
            Itinéraires d'Accès Rapide à Habay Depuis les Points de Repère
          </h2>
          <p class="text-on-surface-variant text-sm sm:text-base leading-relaxed">
            Accès ultra-rapide depuis Arlon en utilisant l'E411 ou la route provinciale N4 :
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="bg-white p-6 rounded-2xl border border-outline-variant/40 shadow-sm space-y-3">
            <div class="flex items-center justify-between">
              <span class="font-bold text-base text-primary">Depuis la Sortie 29 (E411)</span>
              <span class="text-xs bg-emerald-100 text-emerald-800 font-bold px-2 py-0.5 rounded-full">18 min</span>
            </div>
            <p class="text-xs text-on-surface-variant leading-relaxed">
              Via l'<strong>autoroute E411</strong> au départ de l'échangeur d'Arlon Ouest (Stockem). Arrivée au rond-point d'accès de Habay-la-Neuve en 18 minutes sans aucun feu de signalisation.
            </p>
            <p class="text-[11px] text-outline">Distance : 16 km • Trajet idéal pour interventions d'urgence de nuit.</p>
          </div>

          <div class="bg-white p-6 rounded-2xl border border-outline-variant/40 shadow-sm space-y-3">
            <div class="flex items-center justify-between">
              <span class="font-bold text-base text-primary">Depuis le Château du Pont d'Oye</span>
              <span class="text-xs bg-emerald-100 text-emerald-800 font-bold px-2 py-0.5 rounded-full">22 min</span>
            </div>
            <p class="text-xs text-on-surface-variant leading-relaxed">
              Accès par la route forestière menant aux étangs du Pont d'Oye et à la haute vallée. Camionnettes équipées de matériel de détection et hydrocureuse haute pression.
            </p>
            <p class="text-[11px] text-outline">Distance : 19 km • Quartier résidentiel et patrimonial.</p>
          </div>

          <div class="bg-white p-6 rounded-2xl border border-outline-variant/40 shadow-sm space-y-3">
            <div class="flex items-center justify-between">
              <span class="font-bold text-base text-primary">Depuis la Gare de Marbehan</span>
              <span class="text-xs bg-emerald-100 text-emerald-800 font-bold px-2 py-0.5 rounded-full">25 min</span>
            </div>
            <p class="text-xs text-on-surface-variant leading-relaxed">
              Trajet via <strong>Rulles et la N897</strong> pour desservir rapidement la gare, les habitations de cheminots et les zones rurales vers Mellier.
            </p>
            <p class="text-[11px] text-outline">Distance : 22 km • Dépannage chaudière et plomberie sanitaire.</p>
          </div>
        </div>
      </div>

      <!-- 3. Neighborhood-specific content -->
      <div class="bg-surface-container-low rounded-3xl p-8 sm:p-12 border border-outline-variant/40 space-y-8">
        <div class="space-y-2">
          <span class="text-xs font-bold text-secondary uppercase tracking-widest">Typologie Locale</span>
          <h2 class="font-headline-lg text-2xl sm:text-3xl font-extrabold text-primary">
            Spécificités Plomberie des Habitations de Habay
          </h2>
          <p class="text-on-surface-variant text-sm sm:text-base leading-relaxed">
            La configuration semi-forestière et rurale de Habay exige des compétences spécifiques :
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          <div class="bg-white p-6 rounded-2xl border border-outline-variant/30 space-y-3">
            <h3 class="font-bold text-base text-primary flex items-center gap-2">
              <span class="material-symbols-outlined text-secondary">park</span>
              <span>Maisons Isolées & Chalets en Forêt d'Anlier</span>
            </h3>
            <p class="text-xs text-on-surface-variant leading-relaxed">
              Propriétés souvent raccordées à des fosses septiques autonomes ou micro-stations d'épuration. <strong>Besoins réguliers :</strong> curage régulier des canalisations pour prévenir les engorgements de racines, vidange de fosse et protection antigel des circuits de plomberie extérieure.
            </p>
          </div>

          <div class="bg-white p-6 rounded-2xl border border-outline-variant/30 space-y-3">
            <h3 class="font-bold text-base text-primary flex items-center gap-2">
              <span class="material-symbols-outlined text-secondary">villa</span>
              <span>Villas & Résidences Récentes de Habay-la-Neuve</span>
            </h3>
            <p class="text-xs text-on-surface-variant leading-relaxed">
              Habitations modernes accueillant des familles travaillant à Arlon ou Luxembourg. <strong>Demandes fréquentes :</strong> pose d'adoucisseurs d'eau compacts BWT, installation de douches à l'italienne haut de gamme et entretien obligatoire des chaudières à condensation gaz/mazout.
            </p>
          </div>
        </div>
      </div>

      <!-- 4. Local competitor comparison -->
      <div class="bg-white rounded-3xl p-8 sm:p-12 border border-outline-variant/40 shadow-sm space-y-8">
        <div class="text-center max-w-2xl mx-auto space-y-2">
          <span class="text-xs font-bold text-secondary uppercase tracking-widest">Transparence Tarifaire</span>
          <h2 class="font-headline-lg text-2xl sm:text-3xl font-extrabold text-primary">
            Plombier Arlon vs Centrales d'Urgence à Habay
          </h2>
          <p class="text-on-surface-variant text-sm sm:text-base">
            À Habay, faites appel à un vrai artisan de la région plutôt qu'à un numéro surtaxé du web :
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <div class="p-6 rounded-2xl bg-emerald-50/60 border-2 border-emerald-500/40 space-y-4">
            <div class="flex items-center gap-3">
              <span class="p-2 bg-emerald-500 text-white rounded-full flex items-center justify-center">
                <span class="material-symbols-outlined text-[20px]">verified</span>
              </span>
              <div>
                <h3 class="font-bold text-base text-primary">Plombier Arlon (Pour Habay)</h3>
                <span class="text-xs text-emerald-700 font-semibold">Atelier à 15 km (Rue des Faubourgs 14)</span>
              </div>
            </div>
            <ul class="space-y-3 text-xs sm:text-sm text-on-surface">
              <li class="flex items-start gap-2">
                <span class="material-symbols-outlined text-emerald-600 text-[18px] shrink-0 mt-0.5">check_circle</span>
                <span><strong>Arrivée en 20 à 25 min :</strong> Descente directe par la E411 Sortie 29.</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="material-symbols-outlined text-emerald-600 text-[18px] shrink-0 mt-0.5">check_circle</span>
                <span><strong>Agrément Région Wallonne :</strong> Chauffagiste certifié pour attestations légales.</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="material-symbols-outlined text-emerald-600 text-[18px] shrink-0 mt-0.5">check_circle</span>
                <span><strong>Équipement d'hydrocurage propre :</strong> Débouchage sans produits nocifs.</span>
              </li>
            </ul>
          </div>

          <div class="p-6 rounded-2xl bg-rose-50/50 border-2 border-rose-200 space-y-4">
            <div class="flex items-center gap-3">
              <span class="p-2 bg-rose-500 text-white rounded-full flex items-center justify-center">
                <span class="material-symbols-outlined text-[20px]">warning</span>
              </span>
              <div>
                <h3 class="font-bold text-base text-primary">Sociétés Web de Bruxelles / Namur</h3>
                <span class="text-xs text-rose-700 font-semibold">140 à 180 km de distance</span>
              </div>
            </div>
            <ul class="space-y-3 text-xs sm:text-sm text-on-surface-variant">
              <li class="flex items-start gap-2">
                <span class="material-symbols-outlined text-rose-500 text-[18px] shrink-0 mt-0.5">cancel</span>
                <span><strong>Plus de 2h d'attente :</strong> Traversée des Ardennes en hiver très compromise.</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="material-symbols-outlined text-rose-500 text-[18px] shrink-0 mt-0.5">cancel</span>
                <span><strong>Tarifs kilométriques abusifs :</strong> Facturation de centaines d'euros de trajet.</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="material-symbols-outlined text-rose-500 text-[18px] shrink-0 mt-0.5">cancel</span>
                <span><strong>Impossibilité de revoir le technicien :</strong> Zéro service après-vente sur Habay.</span>
              </li>
            </ul>
          </div>
        </div>
      </div>

      <!-- Quick Emergency Call Banner -->
      <div class="bg-gradient-to-r from-primary to-primary-container text-white rounded-3xl p-8 sm:p-10 shadow-xl flex flex-col md:flex-row items-center justify-between gap-6">
        <div class="space-y-2 text-center md:text-left">
          <span class="text-xs font-bold text-secondary-fixed uppercase tracking-wider">Astreinte 24/7 à Habay</span>
          <h3 class="font-headline-md text-2xl font-bold">Une urgence plomberie ou panne de chaudière à Habay ?</h3>
          <p class="text-surface-container-highest text-sm">Notre technicien d'astreinte est prêt à intervenir sous 20 minutes.</p>
        </div>
        <a href="tel:+32472902010" class="inline-flex items-center justify-center gap-2 bg-secondary hover:bg-secondary-container text-white py-3.5 px-6 rounded-xl font-extrabold text-sm shadow-md transition-all shrink-0">
          <span class="material-symbols-outlined text-[20px]">call</span>
          <span>0472 90 20 10</span>
        </a>
      </div>

      <!-- Quote form -->
      <div id="quote-section">
        <QuickQuoteForm />
      </div>

    </div>
  </section>
</Layout>
