---
import Layout from '../../layouts/Layout.astro';
import TrustBar from '../../components/TrustBar.astro';
import QuickQuoteForm from '../../components/QuickQuoteForm.astro';
---

<Layout 
  title="Débouchage Canalisation & WC Arlon (6700) | Curage Haute Pression & Fosse"
  description="Débouchage express de WC, canalisations, éviers et égouts à Arlon. Curage hydrodynamique haute pression 200 bars, caméra d'inspection vidéo et vidange fosse septique. Débouchage 24/7 au 0472 90 20 10."
  canonicalPath="/services/debouchage"
>
  <!-- Schema.org Service JSON-LD -->
  <script type="application/ld+json" slot="head">
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Débouchage & Curage Haute Pression Arlon",
    "provider": {
      "@type": "Plumber",
      "name": "Plombier Arlon",
      "telephone": "+32472902010",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Rue des Faubourgs 14",
        "addressLocality": "Arlon",
        "postalCode": "6700",
        "addressCountry": "BE"
      }
    },
    "areaServed": [
      {"@type": "City", "name": "Arlon"},
      {"@type": "AdministrativeArea", "name": "Bonnert"},
      {"@type": "AdministrativeArea", "name": "Weyler"},
      {"@type": "AdministrativeArea", "name": "Messancy"},
      {"@type": "AdministrativeArea", "name": "Habay"}
    ],
    "serviceType": "Drain Cleaning & Hydrojetting",
    "offers": {
      "@type": "Offer",
      "priceCurrency": "EUR",
      "price": "95.00",
      "description": "Forfait débouchage express mécanique à partir de 95 €"
    }
  }
  </script>

  <!-- Hero Section -->
  <section class="bg-primary text-white py-12 lg:py-16 border-b border-primary-container relative overflow-hidden">
    <div class="max-w-[1240px] mx-auto px-margin sm:px-margin-md space-y-5 relative z-10">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-secondary/20 text-secondary-fixed text-xs font-bold uppercase tracking-wider border border-secondary/30">
        <span class="material-symbols-outlined text-[16px]">water</span>
        <span>Hydrocurage Haute Pression 200 Bars & Caméra HD</span>
      </div>
      <h1 class="font-headline-xl text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight">
        Débouchage de Canalisations, WC & Égouts à Arlon
      </h1>
      <p class="text-surface-container-highest max-w-3xl text-base sm:text-lg leading-relaxed">
        WC bouché qui refoule, évier ou douche qui ne s'évacue plus, odeurs tenaces ou chambre de visite qui déborde ? Intervention rapide 7j/7 avec camionnette hydrocureuse haute pression et caméra vidéo d'inspection sur Arlon et le Sud-Luxembourg.
      </p>
      
      <div class="flex flex-wrap gap-4 pt-2">
        <a href="tel:+32472902010" class="inline-flex items-center gap-2 bg-secondary hover:bg-secondary-container text-white px-6 py-3.5 rounded-xl font-extrabold shadow-lg transition-all text-sm sm:text-base">
          <span class="material-symbols-outlined text-[20px]">call</span>
          <span>SOS Débouchage : 0472 90 20 10</span>
        </a>
        <a href="#quote-section" class="inline-flex items-center gap-2 bg-white/10 hover:bg-white/20 text-white px-5 py-3.5 rounded-xl font-bold border border-white/20 transition-all text-sm">
          <span>Devis Débouchage Gratuit</span>
          <span class="material-symbols-outlined text-[18px]">arrow_downward</span>
        </a>
      </div>
    </div>
  </section>

  <TrustBar />

  <!-- Main Content -->
  <section class="py-16 bg-surface space-y-16">
    <div class="max-w-[1240px] mx-auto px-margin sm:px-margin-md space-y-16">

      <!-- 1. What's included -->
      <div class="bg-white rounded-3xl p-8 sm:p-12 border border-outline-variant/40 shadow-sm space-y-8">
        <div class="space-y-2">
          <span class="text-xs font-bold text-secondary uppercase tracking-widest">Nos Prestations Complètes</span>
          <h2 class="font-headline-lg text-2xl sm:text-3xl font-extrabold text-primary">
            Ce Qui Est Inclus dans Notre Service de Débouchage & Curage
          </h2>
          <p class="text-on-surface-variant text-sm sm:text-base">
            Un équipement de pointe pour éliminer durablement le bouchon sans abîmer vos canalisations.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          <div class="p-5 rounded-2xl bg-surface-container-low border border-outline-variant/30 space-y-2">
            <span class="material-symbols-outlined text-secondary text-[26px]">sanitizer</span>
            <h3 class="font-bold text-base text-primary">Débouchage Sanitaire Intérieur</h3>
            <p class="text-xs text-on-surface-variant leading-relaxed">Désobstruction de WC standards et suspendus, sanibroyeurs, lavabos, douches, baignoires et siphons d'évier.</p>
          </div>

          <div class="p-5 rounded-2xl bg-surface-container-low border border-outline-variant/30 space-y-2">
            <span class="material-symbols-outlined text-secondary text-[26px]">water</span>
            <h3 class="font-bold text-base text-primary">Hydrocurage Haute Pression (200 Bars)</h3>
            <p class="text-xs text-on-surface-variant leading-relaxed">Nettoyage dynamique des parois de canalisations par jet rotatif haute pression pour pulvériser tartre, graisses et boues.</p>
          </div>

          <div class="p-5 rounded-2xl bg-surface-container-low border border-outline-variant/30 space-y-2">
            <span class="material-symbols-outlined text-secondary text-[26px]">videocam</span>
            <h3 class="font-bold text-base text-primary">Inspection Caméra Endoscopique HD</h3>
            <p class="text-xs text-on-surface-variant leading-relaxed">Passage d'une caméra étanche avec sonde émettrice pour localiser l'obstacle, racines, fissures ou affaissements.</p>
          </div>

          <div class="p-5 rounded-2xl bg-surface-container-low border border-outline-variant/30 space-y-2">
            <span class="material-symbols-outlined text-secondary text-[26px]">grid_view</span>
            <h3 class="font-bold text-base text-primary">Débouchage Colonnes & Égouts</h3>
            <p class="text-xs text-on-surface-variant leading-relaxed">Débouchage de sterputs, chambres de visite extérieures, gouttières, collecteurs d'eaux usées et pluviales.</p>
          </div>

          <div class="p-5 rounded-2xl bg-surface-container-low border border-outline-variant/30 space-y-2">
            <span class="material-symbols-outlined text-secondary text-[26px]">delete_sweep</span>
            <h3 class="font-bold text-base text-primary">Vidange & Entretien Fosses Septiques</h3>
            <p class="text-xs text-on-surface-variant leading-relaxed">Pompage des boues, curage des drains d'épandage et dégraissage complet des bacs à graisse en milieu rural.</p>
          </div>

          <div class="p-5 rounded-2xl bg-surface-container-low border border-outline-variant/30 space-y-2">
            <span class="material-symbols-outlined text-secondary text-[26px]">cleaning_services</span>
            <h3 class="font-bold text-base text-primary">Nettoyage & Désinfection Finale</h3>
            <p class="text-xs text-on-surface-variant leading-relaxed">Rinçage et désinfection des sanitaires et du sol après intervention. Chantier laissé parfaitement propre.</p>
          </div>
        </div>
      </div>

      <!-- 2. Common problems we solve -->
      <div class="space-y-8">
        <div class="space-y-2">
          <span class="text-xs font-bold text-primary uppercase tracking-widest">Pannes Courantes</span>
          <h2 class="font-headline-lg text-2xl sm:text-3xl font-extrabold text-primary">
            Les Problèmes de Refoulement & d'Écoulement Que Nous Réglons
          </h2>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          <div class="bg-white p-6 rounded-2xl border border-outline-variant/40 shadow-sm space-y-3">
            <div class="h-10 w-10 rounded-xl bg-red-50 text-secondary flex items-center justify-center font-bold">1</div>
            <h3 class="font-bold text-base text-primary">WC qui Déborde ou Refoule</h3>
            <p class="text-xs text-on-surface-variant leading-relaxed">L'eau monte au niveau de la cuvette lors du tirage de la chasse. Risque imminent de débordement d'eaux noires.</p>
          </div>

          <div class="bg-white p-6 rounded-2xl border border-outline-variant/40 shadow-sm space-y-3">
            <div class="h-10 w-10 rounded-xl bg-red-50 text-secondary flex items-center justify-center font-bold">2</div>
            <h3 class="font-bold text-base text-primary">Évier & Douche Stagnants</h3>
            <p class="text-xs text-on-surface-variant leading-relaxed">Évacuation très lente, glouglous d'air dans les canalisations et résidus savonneux qui stagnent dans le bac de douche.</p>
          </div>

          <div class="bg-white p-6 rounded-2xl border border-outline-variant/40 shadow-sm space-y-3">
            <div class="h-10 w-10 rounded-xl bg-red-50 text-secondary flex items-center justify-center font-bold">3</div>
            <h3 class="font-bold text-base text-primary">Odeurs d'Égout dans la Maison</h3>
            <p class="text-xs text-on-surface-variant leading-relaxed">Remontées d'odeurs pestilentielles par les siphons, colonnes d'aération obstruées ou siphon désamorcé par dépression.</p>
          </div>

          <div class="bg-white p-6 rounded-2xl border border-outline-variant/40 shadow-sm space-y-3">
            <div class="h-10 w-10 rounded-xl bg-red-50 text-secondary flex items-center justify-center font-bold">4</div>
            <h3 class="font-bold text-base text-primary">Chambre de Visite Saturée</h3>
            <p class="text-xs text-on-surface-variant leading-relaxed">Regards d'égout extérieurs qui débordent dans la cour ou le jardin, conduits bloqués par des lingettes ou racines.</p>
          </div>
        </div>
      </div>

      <!-- 3. Our process (step by step) -->
      <div class="bg-surface-container-low rounded-3xl p-8 sm:p-12 border border-outline-variant/40 space-y-8">
        <div class="space-y-2 text-center max-w-2xl mx-auto">
          <span class="text-xs font-bold text-secondary uppercase tracking-widest">Processus d'Intervention</span>
          <h2 class="font-headline-lg text-2xl sm:text-3xl font-extrabold text-primary">
            Comment se Déroule un Débouchage Professionnel à Arlon ?
          </h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-5 gap-6">
          <div class="bg-white p-6 rounded-2xl border border-outline-variant/30 space-y-3">
            <span class="h-8 w-8 rounded-full bg-primary text-white font-bold text-sm flex items-center justify-center">1</span>
            <h3 class="font-bold text-sm text-primary">Diagnostic Initial</h3>
            <p class="text-xs text-on-surface-variant">Identification de l'emplacement du bouchon et vérification des points d'accès (siphon, regard, chambre de visite).</p>
          </div>

          <div class="bg-white p-6 rounded-2xl border border-outline-variant/30 space-y-3">
            <span class="h-8 w-8 rounded-full bg-primary text-white font-bold text-sm flex items-center justify-center">2</span>
            <h3 class="font-bold text-sm text-primary">Inspection Caméra</h3>
            <p class="text-xs text-on-surface-variant">Si nécessaire, introduction de la caméra endoscopique pour visualiser la composition du bouchon et l'état du tuyau.</p>
          </div>

          <div class="bg-white p-6 rounded-2xl border border-outline-variant/30 space-y-3">
            <span class="h-8 w-8 rounded-full bg-primary text-white font-bold text-sm flex items-center justify-center">3</span>
            <h3 class="font-bold text-sm text-primary">Débouchage & Curage</h3>
            <p class="text-xs text-on-surface-variant">Actionnement du furet électromécanique ou hydrocurage haute pression 200 bars pour désagréger l'obstruction.</p>
          </div>

          <div class="bg-white p-6 rounded-2xl border border-outline-variant/30 space-y-3">
            <span class="h-8 w-8 rounded-full bg-primary text-white font-bold text-sm flex items-center justify-center">4</span>
            <h3 class="font-bold text-sm text-primary">Test d'Écoulement</h3>
            <p class="text-xs text-on-surface-variant">Rinçage intensif à grand débit et contrôle de l'évacuation fluide dans tout le collecteur jusqu'à l'égout public.</p>
          </div>

          <div class="bg-white p-6 rounded-2xl border border-outline-variant/30 space-y-3">
            <span class="h-8 w-8 rounded-full bg-primary text-white font-bold text-sm flex items-center justify-center">5</span>
            <h3 class="font-bold text-sm text-primary">Conseils & Propreté</h3>
            <p class="text-xs text-on-surface-variant">Nettoyage complet de la zone et recommandations d'entretien pour prévenir toute récidive.</p>
          </div>
        </div>
      </div>

      <!-- 4. Why choose us -->
      <div class="bg-white rounded-3xl p-8 sm:p-12 border border-outline-variant/40 shadow-sm space-y-8">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
          <div class="lg:col-span-7 space-y-4">
            <span class="text-xs font-bold text-secondary uppercase tracking-widest">Efficacité Sans Chimie</span>
            <h2 class="font-headline-lg text-2xl sm:text-3xl font-extrabold text-primary">
              Pourquoi Éviter les Déboucheurs Chimiques & Choisir Notre Équipe ?
            </h2>
            <div class="space-y-3 text-sm text-on-surface-variant">
              <p class="flex items-start gap-2.5">
                <span class="material-symbols-outlined text-emerald-600 text-[20px] shrink-0 mt-0.5">verified</span>
                <span><strong>Zéro acide corrosif :</strong> Les produits chimiques du commerce rongent les joints, brûlent le PVC et polluent les nappes phréatiques arlonaises sans régler la cause de fond.</span>
              </p>
              <p class="flex items-start gap-2.5">
                <span class="material-symbols-outlined text-emerald-600 text-[20px] shrink-0 mt-0.5">verified</span>
                <span><strong>Camionnette hydrocureuse équipée :</strong> Pression réglable jusqu'à 200 bars pour décoller le calcaire incrusté et les résidus graisseux tenaces.</span>
              </p>
              <p class="flex items-start gap-2.5">
                <span class="material-symbols-outlined text-emerald-600 text-[20px] shrink-0 mt-0.5">verified</span>
                <span><strong>Garantie de résultat :</strong> Si l'eau ne s'écoule pas parfaitement, nous ne partons pas.</span>
              </p>
            </div>
          </div>

          <div class="lg:col-span-5 bg-surface-container-low p-6 sm:p-8 rounded-2xl border border-outline-variant/30 text-center space-y-4">
            <span class="text-xs font-bold text-outline uppercase tracking-wider">Forfait Débouchage Électrique</span>
            <p class="text-3xl font-extrabold text-primary">Dès 95 € <span class="text-xs font-normal text-on-surface-variant">intervention Arlon</span></p>
            <p class="text-xs text-on-surface-variant">Matériel professionnel inclus, sans dégât pour votre sanitaire.</p>
            <a href="tel:+32472902010" class="w-full inline-flex items-center justify-center gap-2 bg-secondary hover:bg-secondary-container text-white py-3.5 px-4 rounded-xl font-bold text-sm shadow-md transition-all">
              <span class="material-symbols-outlined text-[18px]">call</span>
              <span>Ligne Directe Débouchage : 0472 90 20 10</span>
            </a>
          </div>
        </div>
      </div>

      <!-- 5. FAQs -->
      <div class="space-y-6">
        <div class="space-y-2">
          <span class="text-xs font-bold text-primary uppercase tracking-widest">Foire Aux Questions</span>
          <h2 class="font-headline-lg text-2xl sm:text-3xl font-extrabold text-primary">
            Vos Questions sur le Débouchage à Arlon
          </h2>
        </div>

        <div class="space-y-4">
          <details class="group bg-white rounded-xl border border-outline-variant/40 p-5 open:shadow-sm">
            <summary class="font-bold text-sm sm:text-base text-primary cursor-pointer flex items-center justify-between list-none">
              <span>Pourquoi les déboucheurs chimiques vendus en supermarché sont-ils déconseillés ?</span>
              <span class="material-symbols-outlined group-open:rotate-180 transition-transform">expand_more</span>
            </summary>
            <p class="text-xs sm:text-sm text-on-surface-variant mt-3 leading-relaxed">
              La soude caustique et l'acide sulfurique réagissent avec les graisses pour créer un savon durci encore plus difficile à éliminer. De plus, la chaleur chimique dégagée peut déformer les tuyaux en PVC, faire fondre les joints d'étanchéité et détruire la faune bactérienne des fosses septiques.
            </p>
          </details>

          <details class="group bg-white rounded-xl border border-outline-variant/40 p-5 open:shadow-sm">
            <summary class="font-bold text-sm sm:text-base text-primary cursor-pointer flex items-center justify-between list-none">
              <span>Qui doit payer le débouchage : le propriétaire ou le locataire ?</span>
              <span class="material-symbols-outlined group-open:rotate-180 transition-transform">expand_more</span>
            </summary>
            <p class="text-xs sm:text-sm text-on-surface-variant mt-3 leading-relaxed">
              En droit locatif belge, le débouchage courant (dû aux cheveux, papier ou graisses) relève de l'entretien locatif. En revanche, si le bouchon est causé par un défaut structurel (racines d'arbres, canalisation cassée ou contre-pente avérée par inspection caméra), les frais incombent au propriétaire bailleur.
            </p>
          </details>

          <details class="group bg-white rounded-xl border border-outline-variant/40 p-5 open:shadow-sm">
            <summary class="font-bold text-sm sm:text-base text-primary cursor-pointer flex items-center justify-between list-none">
              <span>Faites-vous la vidange de fosse septique en milieu rural ?</span>
              <span class="material-symbols-outlined group-open:rotate-180 transition-transform">expand_more</span>
            </summary>
            <p class="text-xs sm:text-sm text-on-surface-variant mt-3 leading-relaxed">
              Oui, nous intervenons pour la vidange, le curage des drains et le dégraissage des fosses septiques et bacs dégraisseurs dans toute l'entité d'Arlon (Heinsch, Freylange, Fouches...) et les communes rurales voisines (Habay, Attert, Étalle).
            </p>
          </details>
        </div>
      </div>

      <!-- 6. Emergency availability & 7. Service area details -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <div class="bg-primary text-white p-8 rounded-3xl space-y-4">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/10 text-secondary-fixed text-xs font-bold uppercase">
            <span class="material-symbols-outlined text-[16px]">emergency</span> Urgence Refoulement
          </div>
          <h3 class="font-headline-md text-xl sm:text-2xl font-bold">Intervention Express Débouchage</h3>
          <p class="text-surface-container-highest text-sm leading-relaxed">
            Un WC qui déborde ne peut pas attendre. Notre camionnette de débouchage est disponible 7 jours sur 7 avec arrivée sous 30 à 45 minutes pour stopper le sinistre et assainir vos évacuations.
          </p>
          <div class="pt-2">
            <a href="tel:+32472902010" class="inline-flex items-center gap-2 bg-secondary hover:bg-secondary-container text-white py-3 px-5 rounded-xl font-extrabold text-sm shadow-md transition-all">
              <span class="material-symbols-outlined text-[18px]">call</span>
              <span>Appeler le Déboucheur : 0472 90 20 10</span>
            </a>
          </div>
        </div>

        <div class="bg-surface-container-low p-8 rounded-3xl border border-outline-variant/40 space-y-4">
          <div class="inline-flex items-center gap-2 text-primary font-bold text-xs uppercase tracking-wider">
            <span class="material-symbols-outlined text-[16px]">pin_drop</span> Secteurs Couverts
          </div>
          <h3 class="font-headline-md text-xl sm:text-2xl font-bold text-primary">Rayon Débouchage Arlon</h3>
          <ul class="text-xs sm:text-sm text-on-surface-variant space-y-2">
            <li><strong>Arlon & Sections :</strong> Centre, Faubourgs, Bonnert, Frassem, Weyler, Autelbas, Stockem, Viville.</li>
            <li><strong>Sud-Luxembourg :</strong> Messancy, Aubange, Athus, Habay-la-Neuve, Attert, Tintigny.</li>
            <li><strong>Grand-Duché :</strong> Steinfort, Capellen, Windhof (tarif frontalier sans supplément abusif).</li>
          </ul>
        </div>
      </div>

      <!-- Quote form -->
      <div id="quote-section">
        <QuickQuoteForm />
      </div>

    </div>
  </section>
</Layout>
