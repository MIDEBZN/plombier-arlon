---
import Layout from '../../layouts/Layout.astro';
import TrustBar from '../../components/TrustBar.astro';
import QuickQuoteForm from '../../components/QuickQuoteForm.astro';
---

<Layout 
  title="Dépannage Plomberie d'Urgence Arlon (6700) 24/7 | Arrivée en 30 Min"
  description="Dépannage plomberie d'urgence 24h/24 et 7j/7 à Arlon et Sud-Luxembourg. Fuite d'eau, tuyau percé, vanne cassée, dégât des eaux. Artisan local sur place en 30 min. Appelez le 0472 90 20 10."
  canonicalPath="/services/depannage-urgence"
>
  <!-- Schema.org Service JSON-LD -->
  <script type="application/ld+json" slot="head">
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Dépannage Plomberie d'Urgence 24/7 Arlon",
    "provider": {
      "@type": "Plumber",
      "name": "Plombier Arlon",
      "telephone": "+32472902010",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Rue des Faubourgs 14",
        "addressLocality": "Arlon",
        "postalCode": "6700",
        "addressCountry": "BE"
      }
    },
    "areaServed": [
      {"@type": "City", "name": "Arlon"},
      {"@type": "AdministrativeArea", "name": "Bonnert"},
      {"@type": "AdministrativeArea", "name": "Weyler"},
      {"@type": "AdministrativeArea", "name": "Messancy"},
      {"@type": "City", "name": "Steinfort"}
    ],
    "serviceType": "Emergency Plumbing Repair",
    "offers": {
      "@type": "Offer",
      "priceCurrency": "EUR",
      "price": "50.00",
      "description": "Forfait déplacement d'urgence sur Arlon à partir de 50 €"
    }
  }
  </script>

  <!-- Hero Section -->
  <section class="bg-primary text-white py-12 lg:py-16 border-b border-primary-container relative overflow-hidden">
    <div class="max-w-[1240px] mx-auto px-margin sm:px-margin-md space-y-5 relative z-10">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-secondary/20 text-secondary-fixed text-xs font-bold uppercase tracking-wider border border-secondary/30">
        <span class="h-2 w-2 rounded-full bg-secondary animate-pulse"></span>
        <span>Astreinte Immédiate 24h/24 & 7j/7 • Arlon 6700</span>
      </div>
      <h1 class="font-headline-xl text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight">
        Dépannage Plomberie d'Urgence à Arlon
      </h1>
      <p class="text-surface-container-highest max-w-3xl text-base sm:text-lg leading-relaxed">
        Une fuite d'eau abondante, un tuyau gelé ou une vanne d'arrêt défaillante ? Notre équipe d'astreinte intervient <strong>en moins de 30 minutes</strong> à Arlon et communes voisines, de jour comme de nuit.
      </p>
      
      <div class="flex flex-wrap gap-4 pt-2">
        <a href="tel:+32472902010" class="inline-flex items-center gap-2 bg-secondary hover:bg-secondary-container text-white px-6 py-3.5 rounded-xl font-extrabold shadow-lg transition-all text-sm sm:text-base">
          <span class="material-symbols-outlined text-[20px]">call</span>
          <span>Appeler le 0472 90 20 10 (SOS 24/7)</span>
        </a>
        <a href="#quote-section" class="inline-flex items-center gap-2 bg-white/10 hover:bg-white/20 text-white px-5 py-3.5 rounded-xl font-bold border border-white/20 transition-all text-sm">
          <span>Demande de rappel rapide</span>
          <span class="material-symbols-outlined text-[18px]">arrow_downward</span>
        </a>
      </div>
    </div>
  </section>

  <TrustBar />

  <!-- Main Content -->
  <section class="py-16 bg-surface space-y-16">
    <div class="max-w-[1240px] mx-auto px-margin sm:px-margin-md space-y-16">

      <!-- 1. What's included -->
      <div class="bg-white rounded-3xl p-8 sm:p-12 border border-outline-variant/40 shadow-sm space-y-8">
        <div class="space-y-2">
          <span class="text-xs font-bold text-secondary uppercase tracking-widest">Prestations Garanties</span>
          <h2 class="font-headline-lg text-2xl sm:text-3xl font-extrabold text-primary">
            Ce Qui Est Inclus dans Notre Service de Dépannage d'Urgence
          </h2>
          <p class="text-on-surface-variant text-sm sm:text-base">
            Aucun frais caché, aucun devis gonflé sur place : tout est transparent avant le début des réparations.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          <div class="p-5 rounded-2xl bg-surface-container-low border border-outline-variant/30 space-y-2">
            <span class="material-symbols-outlined text-secondary text-[26px]">alarm</span>
            <h3 class="font-bold text-base text-primary">Astreinte 24/7 & Arrivée en 30 Min</h3>
            <p class="text-xs text-on-surface-variant leading-relaxed">Prise en charge téléphonique immédiate par un technicien de garde et départ d'un artisan local.</p>
          </div>

          <div class="p-5 rounded-2xl bg-surface-container-low border border-outline-variant/30 space-y-2">
            <span class="material-symbols-outlined text-secondary text-[26px]">search</span>
            <h3 class="font-bold text-base text-primary">Diagnostic & Sécurisation Immédiate</h3>
            <p class="text-xs text-on-surface-variant leading-relaxed">Arrêt d'urgence de la fuite, mise en sécurité électrique et coupure ciblée du tronçon fuyard.</p>
          </div>

          <div class="p-5 rounded-2xl bg-surface-container-low border border-outline-variant/30 space-y-2">
            <span class="material-symbols-outlined text-secondary text-[26px]">receipt</span>
            <h3 class="font-bold text-base text-primary">Devis Écrit Prévallidé</h3>
            <p class="text-xs text-on-surface-variant leading-relaxed">Tarification fixe annoncée et acceptée avant tout coup de clé ou remplacement de pièce.</p>
          </div>

          <div class="p-5 rounded-2xl bg-surface-container-low border border-outline-variant/30 space-y-2">
            <span class="material-symbols-outlined text-secondary text-[26px]">inventory_2</span>
            <h3 class="font-bold text-base text-primary">Stock de Pièces dans le Véhicule</h3>
            <p class="text-xs text-on-surface-variant leading-relaxed">Raccords cuivre, multicouche, flexibles renforcés, vannes d'arrêt et joints certifiés Belgaqua.</p>
          </div>

          <div class="p-5 rounded-2xl bg-surface-container-low border border-outline-variant/30 space-y-2">
            <span class="material-symbols-outlined text-secondary text-[26px]">verified</span>
            <h3 class="font-bold text-base text-primary">Test de Pression & Contrôle d'Étanchéité</h3>
            <p class="text-xs text-on-surface-variant leading-relaxed">Remise en eau progressive et test de résistance à la pression nominale avant notre départ.</p>
          </div>

          <div class="p-5 rounded-2xl bg-surface-container-low border border-outline-variant/30 space-y-2">
            <span class="material-symbols-outlined text-secondary text-[26px]">description</span>
            <h3 class="font-bold text-base text-primary">Facture & Rapport pour Assurance</h3>
            <p class="text-xs text-on-surface-variant leading-relaxed">Délivrance immédiate d'un rapport conforme pour votre assurance habitation (Ethias, AXA, AG...).</p>
          </div>
        </div>
      </div>

      <!-- 2. Common problems we solve -->
      <div class="space-y-8">
        <div class="space-y-2">
          <span class="text-xs font-bold text-primary uppercase tracking-widest">Diagnostics Rapides</span>
          <h2 class="font-headline-lg text-2xl sm:text-3xl font-extrabold text-primary">
            Les Urgences Plomberie Que Nous Résolvons Quotidiennement à Arlon
          </h2>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          <div class="bg-white p-6 rounded-2xl border border-outline-variant/40 shadow-sm space-y-3">
            <div class="h-10 w-10 rounded-xl bg-red-50 text-secondary flex items-center justify-center font-bold">1</div>
            <h3 class="font-bold text-base text-primary">Tuyau Percé ou Fissuré</h3>
            <p class="text-xs text-on-surface-variant leading-relaxed">Rupture de cuivre soudé, canalisation multicouche percée par une vis ou un raccord défaillant sous chape.</p>
          </div>

          <div class="bg-white p-6 rounded-2xl border border-outline-variant/40 shadow-sm space-y-3">
            <div class="h-10 w-10 rounded-xl bg-red-50 text-secondary flex items-center justify-center font-bold">2</div>
            <h3 class="font-bold text-base text-primary">Vanne d'Arrêt Cassée</h3>
            <p class="text-xs text-on-surface-variant leading-relaxed">Robinet de coupure générale bloqué ou qui tourne dans le vide pendant une fuite majeure. Remplacement sous pression.</p>
          </div>

          <div class="bg-white p-6 rounded-2xl border border-outline-variant/40 shadow-sm space-y-3">
            <div class="h-10 w-10 rounded-xl bg-red-50 text-secondary flex items-center justify-center font-bold">3</div>
            <h3 class="font-bold text-base text-primary">Tuyauterie Gelée en Hiver</h3>
            <p class="text-xs text-on-surface-variant leading-relaxed">Froid ardennais intense : dégel thermique sécurisé des conduites extérieures et garages sans éclatement.</p>
          </div>

          <div class="bg-white p-6 rounded-2xl border border-outline-variant/40 shadow-sm space-y-3">
            <div class="h-10 w-10 rounded-xl bg-red-50 text-secondary flex items-center justify-center font-bold">4</div>
            <h3 class="font-bold text-base text-primary">WC Bloqué ou Débordant</h3>
            <p class="text-xs text-on-surface-variant leading-relaxed">Flotteur Geberit entartré, cuvette qui déborde, fuite d'eau sale au pied du WC ou chasse qui coule en continu.</p>
          </div>
        </div>
      </div>

      <!-- 3. Our process (step by step) -->
      <div class="bg-surface-container-low rounded-3xl p-8 sm:p-12 border border-outline-variant/40 space-y-8">
        <div class="space-y-2 text-center max-w-2xl mx-auto">
          <span class="text-xs font-bold text-secondary uppercase tracking-widest">Méthodologie Éprouvée</span>
          <h2 class="font-headline-lg text-2xl sm:text-3xl font-extrabold text-primary">
            Notre Processus d'Intervention d'Urgence en 5 Étapes
          </h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-5 gap-6">
          <div class="bg-white p-6 rounded-2xl border border-outline-variant/30 space-y-3">
            <span class="h-8 w-8 rounded-full bg-primary text-white font-bold text-sm flex items-center justify-center">1</span>
            <h3 class="font-bold text-sm text-primary">Appel & Consignes</h3>
            <p class="text-xs text-on-surface-variant">Conseils immédiats par téléphone pour couper la vanne générale et limiter les dégâts des eaux.</p>
          </div>

          <div class="bg-white p-6 rounded-2xl border border-outline-variant/30 space-y-3">
            <span class="h-8 w-8 rounded-full bg-primary text-white font-bold text-sm flex items-center justify-center">2</span>
            <h3 class="font-bold text-sm text-primary">Départ Rapide</h3>
            <p class="text-xs text-on-surface-variant">Notre camionnette d'astreinte basée à Arlon prend la route en direction de votre domicile (< 30 min).</p>
          </div>

          <div class="bg-white p-6 rounded-2xl border border-outline-variant/30 space-y-3">
            <span class="h-8 w-8 rounded-full bg-primary text-white font-bold text-sm flex items-center justify-center">3</span>
            <h3 class="font-bold text-sm text-primary">Diagnostic & Devis</h3>
            <p class="text-xs text-on-surface-variant">Identification visuelle ou technique de la fuite et présentation d'un devis clair et sans surprise.</p>
          </div>

          <div class="bg-white p-6 rounded-2xl border border-outline-variant/30 space-y-3">
            <span class="h-8 w-8 rounded-full bg-primary text-white font-bold text-sm flex items-center justify-center">4</span>
            <h3 class="font-bold text-sm text-primary">Réparation</h3>
            <p class="text-xs text-on-surface-variant">Remplacement de la conduite, sertissage ou brasage de pièce neuve et test d'étanchéité sous pression.</p>
          </div>

          <div class="bg-white p-6 rounded-2xl border border-outline-variant/30 space-y-3">
            <span class="h-8 w-8 rounded-full bg-primary text-white font-bold text-sm flex items-center justify-center">5</span>
            <h3 class="font-bold text-sm text-primary">Rapport Assurance</h3>
            <p class="text-xs text-on-surface-variant">Remise de la facture détaillée et attestation pour la prise en charge par votre assureur.</p>
          </div>
        </div>
      </div>

      <!-- 4. Why choose us -->
      <div class="bg-white rounded-3xl p-8 sm:p-12 border border-outline-variant/40 shadow-sm space-y-8">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
          <div class="lg:col-span-7 space-y-4">
            <span class="text-xs font-bold text-secondary uppercase tracking-widest">Fiabilité & Proximité</span>
            <h2 class="font-headline-lg text-2xl sm:text-3xl font-extrabold text-primary">
              Pourquoi Choisir Notre Service d'Urgence à Arlon ?
            </h2>
            <div class="space-y-3 text-sm text-on-surface-variant">
              <p class="flex items-start gap-2.5">
                <span class="material-symbols-outlined text-emerald-600 text-[20px] shrink-0 mt-0.5">verified</span>
                <span><strong>Véritable présence locale :</strong> Notre atelier est situé Rue des Faubourgs 14 à Arlon (6700). Nous ne venons pas de Liège ou Bruxelles.</span>
              </p>
              <p class="flex items-start gap-2.5">
                <span class="material-symbols-outlined text-emerald-600 text-[20px] shrink-0 mt-0.5">verified</span>
                <span><strong>Pas d'intermédiaire ni sous-traitance opaque :</strong> Vous parlez directement avec l'artisan qui intervient sur votre sinistre.</span>
              </p>
              <p class="flex items-start gap-2.5">
                <span class="material-symbols-outlined text-emerald-600 text-[20px] shrink-0 mt-0.5">verified</span>
                <span><strong>Agréé par toutes les assurances belges :</strong> Rapports complets acceptés par Ethias, AXA, AG Insurance, Baloise et P&V.</span>
              </p>
            </div>
          </div>

          <div class="lg:col-span-5 bg-surface-container-low p-6 sm:p-8 rounded-2xl border border-outline-variant/30 text-center space-y-4">
            <span class="text-xs font-bold text-outline uppercase tracking-wider">Tarif Forfaitaire Indicatif</span>
            <p class="text-3xl font-extrabold text-primary">Dès 50 € <span class="text-xs font-normal text-on-surface-variant">déplacement Arlon</span></p>
            <p class="text-xs text-on-surface-variant">Devis remis et validé par vos soins avant le moindre démontage.</p>
            <a href="tel:+32472902010" class="w-full inline-flex items-center justify-center gap-2 bg-secondary hover:bg-secondary-container text-white py-3.5 px-4 rounded-xl font-bold text-sm shadow-md transition-all">
              <span class="material-symbols-outlined text-[18px]">call</span>
              <span>Ligne d'Urgence : 0472 90 20 10</span>
            </a>
          </div>
        </div>
      </div>

      <!-- 5. FAQs -->
      <div class="space-y-6">
        <div class="space-y-2">
          <span class="text-xs font-bold text-primary uppercase tracking-widest">Questions Réponses</span>
          <h2 class="font-headline-lg text-2xl sm:text-3xl font-extrabold text-primary">
            Foire Aux Questions : Dépannage Plomberie d'Urgence
          </h2>
        </div>

        <div class="space-y-4">
          <details class="group bg-white rounded-xl border border-outline-variant/40 p-5 open:shadow-sm">
            <summary class="font-bold text-sm sm:text-base text-primary cursor-pointer flex items-center justify-between list-none">
              <span>Quel est le délai réel d'arrivée en pleine nuit ou le week-end ?</span>
              <span class="material-symbols-outlined group-open:rotate-180 transition-transform">expand_more</span>
            </summary>
            <p class="text-xs sm:text-sm text-on-surface-variant mt-3 leading-relaxed">
              Sur l'entité d'Arlon (centre, Bonnert, Weyler, Stockem, Heinsch), notre artisan d'astreinte arrive généralement sous 20 à 30 minutes. Pour les communes limitrophes (Messancy, Habay, Aubange), comptez 30 à 45 minutes maximum.
            </p>
          </details>

          <details class="group bg-white rounded-xl border border-outline-variant/40 p-5 open:shadow-sm">
            <summary class="font-bold text-sm sm:text-base text-primary cursor-pointer flex items-center justify-between list-none">
              <span>La réparation d'urgence est-elle remboursée par l'assurance habitation ?</span>
              <summary-p class="text-xs sm:text-sm text-on-surface-variant mt-3 leading-relaxed block">
                Oui. Dans la majorité des polices d'assurance incendie et dégât des eaux belges (AXA, Ethias, AG...), les frais de recherche de fuite et les conséquences de la fuite sont remboursés. Nous vous fournissons la facture acquittée avec descriptif technique précis.
              </summary-p>
            </summary>
          </details>

          <details class="group bg-white rounded-xl border border-outline-variant/40 p-5 open:shadow-sm">
            <summary class="font-bold text-sm sm:text-base text-primary cursor-pointer flex items-center justify-between list-none">
              <span>Que faire immédiatement en attendant l'arrivée de votre technicien ?</span>
              <span class="material-symbols-outlined group-open:rotate-180 transition-transform">expand_more</span>
            </summary>
            <p class="text-xs sm:text-sm text-on-surface-variant mt-3 leading-relaxed">
              Coupez immédiatement l'eau à la vanne d'arrêt générale (située avant ou après votre compteur d'eau SWDE). Si l'eau risque de toucher des prises ou appareils électriques, coupez le disjoncteur général. Prenez des photos pour l'assurance et aérez les pièces touchées.
            </p>
          </details>
        </div>
      </div>

      <!-- 6. Emergency availability & 7. Service area details -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <div class="bg-primary text-white p-8 rounded-3xl space-y-4">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/10 text-secondary-fixed text-xs font-bold uppercase">
            <span class="material-symbols-outlined text-[16px]">schedule</span> Disponibilité 24/7/365
          </div>
          <h3 class="font-headline-md text-xl sm:text-2xl font-bold">Service d'Astreinte Non-Stop</h3>
          <p class="text-surface-container-highest text-sm leading-relaxed">
            Notre service d'urgence fonctionne sans interruption : 24h/24, 7 jours sur 7, samedis, dimanches et tous les jours fériés. Une équipe est constamment de piquet avec un véhicule approvisionné.
          </p>
          <div class="pt-2">
            <a href="tel:+32472902010" class="inline-flex items-center gap-2 bg-secondary hover:bg-secondary-container text-white py-3 px-5 rounded-xl font-extrabold text-sm shadow-md transition-all">
              <span class="material-symbols-outlined text-[18px]">call</span>
              <span>Ligne Directe : 0472 90 20 10</span>
            </a>
          </div>
        </div>

        <div class="bg-surface-container-low p-8 rounded-3xl border border-outline-variant/40 space-y-4">
          <div class="inline-flex items-center gap-2 text-primary font-bold text-xs uppercase tracking-wider">
            <span class="material-symbols-outlined text-[16px]">map</span> Périmètre d'Intervention
          </div>
          <h3 class="font-headline-md text-xl sm:text-2xl font-bold text-primary">Arlon & Sud-Luxembourg</h3>
          <ul class="text-xs sm:text-sm text-on-surface-variant space-y-2">
            <li><strong>Grand Arlon (6700) :</strong> Centre-ville, Bonnert, Weyler, Stockem, Heinsch, Toernich, Viville, Sterpenich.</li>
            <li><strong>Communes voisines :</strong> Messancy, Aubange, Athus, Habay, Attert, Étalle, Tintigny.</li>
            <li><strong>Frontière Luxembourg :</strong> Steinfort, Capellen, Windhof (accès direct E411).</li>
          </ul>
        </div>
      </div>

      <!-- Quote & diagnostic form -->
      <div id="quote-section">
        <QuickQuoteForm />
      </div>

    </div>
  </section>
</Layout>
