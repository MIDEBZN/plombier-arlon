---
import Layout from '../../layouts/Layout.astro';
import TrustBar from '../../components/TrustBar.astro';
import QuickQuoteForm from '../../components/QuickQuoteForm.astro';
---

<Layout 
  title="Recherche de Fuite d'Eau Arlon (6700) | Détection Non Destructive & Caméra Thermique"
  description="Recherche de fuite d'eau non destructive à Arlon. Localisation sans casser par caméra thermique infrarouge, électro-acoustique et gaz traceur. Rapport officiel 100% pris en charge assurance. Contactez le 0472 90 20 10."
  canonicalPath="/services/detection-fuites"
>
  <!-- Schema.org Service JSON-LD -->
  <script type="application/ld+json" slot="head">
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Recherche de Fuite d'Eau Non Destructive Arlon",
    "provider": {
      "@type": "Plumber",
      "name": "Plombier Arlon",
      "telephone": "+32472902010",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Rue des Faubourgs 14",
        "addressLocality": "Arlon",
        "postalCode": "6700",
        "addressCountry": "BE"
      }
    },
    "areaServed": [
      {"@type": "City", "name": "Arlon"},
      {"@type": "AdministrativeArea", "name": "Bonnert"},
      {"@type": "AdministrativeArea", "name": "Weyler"},
      {"@type": "AdministrativeArea", "name": "Messancy"},
      {"@type": "AdministrativeArea", "name": "Aubange"}
    ],
    "serviceType": "Non-Destructive Leak Detection",
    "offers": {
      "@type": "Offer",
      "priceCurrency": "EUR",
      "price": "180.00",
      "description": "Diagnostic de recherche de fuite d'eau certifié assurance dès 180 €"
    }
  }
  </script>

  <!-- Hero Section -->
  <section class="bg-primary text-white py-12 lg:py-16 border-b border-primary-container relative overflow-hidden">
    <div class="max-w-[1240px] mx-auto px-margin sm:px-margin-md space-y-5 relative z-10">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-secondary/20 text-secondary-fixed text-xs font-bold uppercase tracking-wider border border-secondary/30">
        <span class="material-symbols-outlined text-[16px]">thermostat</span>
        <span>Localisation Sans Casse • Rapport Officiel Assurance</span>
      </div>
      <h1 class="font-headline-xl text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight">
        Recherche de Fuite d'Eau Non Destructive à Arlon
      </h1>
      <p class="text-surface-container-highest max-w-3xl text-base sm:text-lg leading-relaxed">
        Votre compteur d'eau tourne sans arrêt ? Des auréoles d'humidité ou de la moisissure apparaissent sur vos murs ou plafonds ? Nous localisons la fuite au millimètre près <strong>sans casser vos carrelages, chapes ou cloisons</strong>.
      </p>
      
      <div class="flex flex-wrap gap-4 pt-2">
        <a href="tel:+32472902010" class="inline-flex items-center gap-2 bg-secondary hover:bg-secondary-container text-white px-6 py-3.5 rounded-xl font-extrabold shadow-lg transition-all text-sm sm:text-base">
          <span class="material-symbols-outlined text-[20px]">call</span>
          <span>Détecter une fuite : 0472 90 20 10</span>
        </a>
        <a href="#quote-section" class="inline-flex items-center gap-2 bg-white/10 hover:bg-white/20 text-white px-5 py-3.5 rounded-xl font-bold border border-white/20 transition-all text-sm">
          <span>Demande de rapport d'expertise</span>
          <span class="material-symbols-outlined text-[18px]">arrow_downward</span>
        </a>
      </div>
    </div>
  </section>

  <TrustBar />

  <!-- Main Content -->
  <section class="py-16 bg-surface space-y-16">
    <div class="max-w-[1240px] mx-auto px-margin sm:px-margin-md space-y-16">

      <!-- 1. What's included -->
      <div class="bg-white rounded-3xl p-8 sm:p-12 border border-outline-variant/40 shadow-sm space-y-8">
        <div class="space-y-2">
          <span class="text-xs font-bold text-secondary uppercase tracking-widest">Technologies Embarquées</span>
          <h2 class="font-headline-lg text-2xl sm:text-3xl font-extrabold text-primary">
            Ce Qui Est Inclus dans Notre Diagnostic de Recherche de Fuite
          </h2>
          <p class="text-on-surface-variant text-sm sm:text-base">
            La combinaison des 4 technologies les plus avancées pour une localisation infaillible sans destruction.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          <div class="p-5 rounded-2xl bg-surface-container-low border border-outline-variant/30 space-y-2">
            <span class="material-symbols-outlined text-secondary text-[26px]">thermostat</span>
            <h3 class="font-bold text-base text-primary">Caméra Thermique Infrarouge (FLIR)</h3>
            <p class="text-xs text-on-surface-variant leading-relaxed">Visualisation des écarts de température dans les dalles, chapes, murs et planchers chauffants pour révéler la zone exacte d'infiltration.</p>
          </div>

          <div class="p-5 rounded-2xl bg-surface-container-low border border-outline-variant/30 space-y-2">
            <span class="material-symbols-outlined text-secondary text-[26px]">hearing</span>
            <h3 class="font-bold text-base text-primary">Détection Électro-Acoustique (Sewerin)</h3>
            <p class="text-xs text-on-surface-variant leading-relaxed">Microphones de sol et capteurs piézoélectriques amplifiés pour capter la vibration acoustique générée par l'eau sous pression.</p>
          </div>

          <div class="p-5 rounded-2xl bg-surface-container-low border border-outline-variant/30 space-y-2">
            <span class="material-symbols-outlined text-secondary text-[26px]">air</span>
            <h3 class="font-bold text-base text-primary">Injection de Gaz Traceur (Azote/Hydrogène)</h3>
            <p class="text-xs text-on-surface-variant leading-relaxed">Gaz inodore, ininflammable et non toxique injecté dans la conduite vidangée. Détecteur renifleur capable de repérer une micro-fuite sous 1 m de béton.</p>
          </div>

          <div class="p-5 rounded-2xl bg-surface-container-low border border-outline-variant/30 space-y-2">
            <span class="material-symbols-outlined text-secondary text-[26px]">videocam</span>
            <h3 class="font-bold text-base text-primary">Inspection Caméra Endoscopique</h3>
            <p class="text-xs text-on-surface-variant leading-relaxed">Contrôle visuel direct à l'intérieur des évacuations et gaines techniques pour identifier les déboîtements et micro-fissures.</p>
          </div>

          <div class="p-5 rounded-2xl bg-surface-container-low border border-outline-variant/30 space-y-2">
            <span class="material-symbols-outlined text-secondary text-[26px]">speed</span>
            <h3 class="font-bold text-base text-primary">Test de Pression Différentielle</h3>
            <p class="text-xs text-on-surface-variant leading-relaxed">Isolement circuit par circuit (eau froide, eau chaude sanitaire, chauffage) pour isoler mathématiquement le réseau fuyard.</p>
          </div>

          <div class="p-5 rounded-2xl bg-surface-container-low border border-outline-variant/30 space-y-2">
            <span class="material-symbols-outlined text-secondary text-[26px]">assignment_turned_in</span>
            <h3 class="font-bold text-base text-primary">Rapport d'Expertise Agréé Assurance</h3>
            <p class="text-xs text-on-surface-variant leading-relaxed">Dossier technique illustré avec clichés thermographiques, localisation cotée et préconisations de réparation pour votre assureur.</p>
          </div>
        </div>
      </div>

      <!-- 2. Common problems we solve -->
      <div class="space-y-8">
        <div class="space-y-2">
          <span class="text-xs font-bold text-primary uppercase tracking-widest">Symptômes Fréquents</span>
          <h2 class="font-headline-lg text-2xl sm:text-3xl font-extrabold text-primary">
            Comment Savoir si Vous Avez une Fuite Cachée ?
          </h2>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          <div class="bg-white p-6 rounded-2xl border border-outline-variant/40 shadow-sm space-y-3">
            <div class="h-10 w-10 rounded-xl bg-red-50 text-secondary flex items-center justify-center font-bold">1</div>
            <h3 class="font-bold text-base text-primary">Compteur SWDE qui Tourne</h3>
            <p class="text-xs text-on-surface-variant leading-relaxed">La petite roulette rouge ou l'index digital de votre compteur d'eau avance alors que tous les robinets sont fermés.</p>
          </div>

          <div class="bg-white p-6 rounded-2xl border border-outline-variant/40 shadow-sm space-y-3">
            <div class="h-10 w-10 rounded-xl bg-red-50 text-secondary flex items-center justify-center font-bold">2</div>
            <h3 class="font-bold text-base text-primary">Auréole & Tache au Plafond</h3>
            <p class="text-xs text-on-surface-variant leading-relaxed">Peinture qui cloque, auréole jaunâtre qui s'étend, odeur de moisi ou salpêtre apparaissant sur les plâtres.</p>
          </div>

          <div class="bg-white p-6 rounded-2xl border border-outline-variant/40 shadow-sm space-y-3">
            <div class="h-10 w-10 rounded-xl bg-red-50 text-secondary flex items-center justify-center font-bold">3</div>
            <h3 class="font-bold text-base text-primary">Perte de Pression Chaudière</h3>
            <p class="text-xs text-on-surface-variant leading-relaxed">Vous devez régulièrement rajouter de l'eau dans le circuit de chauffage (baisse sous 1 bar). Micro-fuite sur les tuyaux encastrés.</p>
          </div>

          <div class="bg-white p-6 rounded-2xl border border-outline-variant/40 shadow-sm space-y-3">
            <div class="h-10 w-10 rounded-xl bg-red-50 text-secondary flex items-center justify-center font-bold">4</div>
            <h3 class="font-bold text-base text-primary">Parquet qui Gondole</h3>
            <p class="text-xs text-on-surface-variant leading-relaxed">Lames de sol qui se soulèvent ou joints de carrelage qui s'effritent à cause d'une humidité ascensionnelle sous chape.</p>
          </div>
        </div>
      </div>

      <!-- 3. Our process (step by step) -->
      <div class="bg-surface-container-low rounded-3xl p-8 sm:p-12 border border-outline-variant/40 space-y-8">
        <div class="space-y-2 text-center max-w-2xl mx-auto">
          <span class="text-xs font-bold text-secondary uppercase tracking-widest">Protocole d'Investigation</span>
          <h2 class="font-headline-lg text-2xl sm:text-3xl font-extrabold text-primary">
            Les 5 Étapes de Notre Recherche de Fuite d'Eau
          </h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-5 gap-6">
          <div class="bg-white p-6 rounded-2xl border border-outline-variant/30 space-y-3">
            <span class="h-8 w-8 rounded-full bg-primary text-white font-bold text-sm flex items-center justify-center">1</span>
            <h3 class="font-bold text-sm text-primary">Mise sous Pression</h3>
            <p class="text-xs text-on-surface-variant">Manomètre sur chaque réseau pour déterminer immédiatement si la fuite se situe sur l'eau potable ou le chauffage.</p>
          </div>

          <div class="bg-white p-6 rounded-2xl border border-outline-variant/30 space-y-3">
            <span class="h-8 w-8 rounded-full bg-primary text-white font-bold text-sm flex items-center justify-center">2</span>
            <h3 class="font-bold text-sm text-primary">Thermographie FLIR</h3>
            <p class="text-xs text-on-surface-variant">Balayage thermique des sols et murs pour cartographier les variations thermiques révélatrices de l'humidité.</p>
          </div>

          <div class="bg-white p-6 rounded-2xl border border-outline-variant/30 space-y-3">
            <span class="h-8 w-8 rounded-full bg-primary text-white font-bold text-sm flex items-center justify-center">3</span>
            <h3 class="font-bold text-sm text-primary">Acoustique / Gaz</h3>
            <p class="text-xs text-on-surface-variant">Affinement millimétrique par écoute au sol ou injection de gaz traceur pour pointer le point de fuite précis.</p>
          </div>

          <div class="bg-white p-6 rounded-2xl border border-outline-variant/30 space-y-3">
            <span class="h-8 w-8 rounded-full bg-primary text-white font-bold text-sm flex items-center justify-center">4</span>
            <h3 class="font-bold text-sm text-primary">Marquage Précis</h3>
            <p class="text-xs text-on-surface-variant">Traçage au sol au feutre amovible : aucune démolition générale, seule une ouverture minimale de quelques centimètres sera requise.</p>
          </div>

          <div class="bg-white p-6 rounded-2xl border border-outline-variant/30 space-y-3">
            <span class="h-8 w-8 rounded-full bg-primary text-white font-bold text-sm flex items-center justify-center">5</span>
            <h3 class="font-bold text-sm text-primary">Dossier Assurance</h3>
            <p class="text-xs text-on-surface-variant">Envoi immédiat du rapport complet avec photos thermiques à votre compagnie d'assurance pour remboursement intégral.</p>
          </div>
        </div>
      </div>

      <!-- 4. Why choose us -->
      <div class="bg-white rounded-3xl p-8 sm:p-12 border border-outline-variant/40 shadow-sm space-y-8">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
          <div class="lg:col-span-7 space-y-4">
            <span class="text-xs font-bold text-secondary uppercase tracking-widest">Prise en Charge à 100%</span>
            <h2 class="font-headline-lg text-2xl sm:text-3xl font-extrabold text-primary">
              Pourquoi Notre Recherche de Fuite est Couverte par Votre Assurance ?
            </h2>
            <div class="space-y-3 text-sm text-on-surface-variant">
              <p class="flex items-start gap-2.5">
                <span class="material-symbols-outlined text-emerald-600 text-[20px] shrink-0 mt-0.5">verified</span>
                <span><strong>Clause « Dégât des Eaux » des polices belges :</strong> En Belgique, votre contrat d'assurance habitation prend en charge les frais de recherche non destructive et de remise en état.</span>
              </p>
              <p class="flex items-start gap-2.5">
                <span class="material-symbols-outlined text-emerald-600 text-[20px] shrink-0 mt-0.5">verified</span>
                <span><strong>Rapports standardisés CSTC :</strong> Nos documents contiennent les éléments indispensables aux experts d'assurances (localisation, cause technique, mesures d'humidité et photos horodatées).</span>
              </p>
              <p class="flex items-start gap-2.5">
                <span class="material-symbols-outlined text-emerald-600 text-[20px] shrink-0 mt-0.5">verified</span>
                <span><strong>Économies considérables :</strong> En évitant de casser une chape carrelée au hasard, nous vous épargnons des semaines de travaux et des milliers d'euros de réfection.</span>
              </p>
            </div>
          </div>

          <div class="lg:col-span-5 bg-surface-container-low p-6 sm:p-8 rounded-2xl border border-outline-variant/30 text-center space-y-4">
            <span class="text-xs font-bold text-outline uppercase tracking-wider">Diagnostic Recherche de Fuite</span>
            <p class="text-3xl font-extrabold text-primary">Dès 180 € <span class="text-xs font-normal text-on-surface-variant">remboursable assurance</span></p>
            <p class="text-xs text-on-surface-variant">Rapport officiel délivré sous 24h avec thermogrammes FLIR.</p>
            <a href="tel:+32472902010" class="w-full inline-flex items-center justify-center gap-2 bg-secondary hover:bg-secondary-container text-white py-3.5 px-4 rounded-xl font-bold text-sm shadow-md transition-all">
              <span class="material-symbols-outlined text-[18px]">call</span>
              <span>Prendre Rendez-vous : 0472 90 20 10</span>
            </a>
          </div>
        </div>
      </div>

      <!-- 5. FAQs -->
      <div class="space-y-6">
        <div class="space-y-2">
          <span class="text-xs font-bold text-primary uppercase tracking-widest">Vos Interrogations</span>
          <h2 class="font-headline-lg text-2xl sm:text-3xl font-extrabold text-primary">
            Questions Fréquentes sur la Recherche de Fuite
          </h2>
        </div>

        <div class="space-y-4">
          <details class="group bg-white rounded-xl border border-outline-variant/40 p-5 open:shadow-sm">
            <summary class="font-bold text-sm sm:text-base text-primary cursor-pointer flex items-center justify-between list-none">
              <span>Mon assurance habitation prend-elle en charge le coût de la détection ?</span>
              <span class="material-symbols-outlined group-open:rotate-180 transition-transform">expand_more</span>
            </summary>
            <p class="text-xs sm:text-sm text-on-surface-variant mt-3 leading-relaxed">
              Oui, la garantie « Recherche de fuite » est présente dans la quasi-totalité des contrats multirisques habitation en Belgique (Ethias, AXA, AG Insurance, Baloise, Allianz...). Notre facture et notre rapport d'intervention vous sont intégralement remboursés après déclaration du sinistre à votre courtier.
            </p>
          </details>

          <details class="group bg-white rounded-xl border border-outline-variant/40 p-5 open:shadow-sm">
            <summary class="font-bold text-sm sm:text-base text-primary cursor-pointer flex items-center justify-between list-none">
              <span>Allez-vous casser mon carrelage pour chercher la fuite ?</span>
              <span class="material-symbols-outlined group-open:rotate-180 transition-transform">expand_more</span>
            </summary>
            <p class="text-xs sm:text-sm text-on-surface-variant mt-3 leading-relaxed">
              Absolument pas lors de la phase de détection. Nos technologies sont 100% non destructives (infrarouge, stéthoscope acoustique, gaz traceur). Nous ne touchons à aucun carrelage. Ce n'est qu'au moment de la réparation que nous n'ouvrons que sur 10 à 20 cm très précisément à l'endroit identifié.
            </p>
          </details>

          <details class="group bg-white rounded-xl border border-outline-variant/40 p-5 open:shadow-sm">
            <summary class="font-bold text-sm sm:text-base text-primary cursor-pointer flex items-center justify-between list-none">
              <span>Comment faire la différence entre une fuite d'eau et une infiltration d'eau de pluie ?</span>
              <span class="material-symbols-outlined group-open:rotate-180 transition-transform">expand_more</span>
            </summary>
            <p class="text-xs sm:text-sm text-on-surface-variant mt-3 leading-relaxed">
              Notre protocole commence par le contrôle manométrique des réseaux sous pression et l'analyse de l'eau (test de présence de chlore par réactif chimique). Si l'eau contient du chlore, elle provient du réseau de distribution d'eau potable de la ville (SWDE). Si elle n'en contient pas, il s'agit d'eaux pluviales ou d'eaux usées.
            </p>
          </details>
        </div>
      </div>

      <!-- 6. Emergency availability & 7. Service area details -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <div class="bg-primary text-white p-8 rounded-3xl space-y-4">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/10 text-secondary-fixed text-xs font-bold uppercase">
            <span class="material-symbols-outlined text-[16px]">priority_high</span> Urgence Sinistre
          </div>
          <h3 class="font-headline-md text-xl sm:text-2xl font-bold">Intervention d'Urgence sous 24h</h3>
          <p class="text-surface-container-highest text-sm leading-relaxed">
            Pour les fuites abondantes menaçant la structure de votre habitation ou le logement du voisin du dessous, nous nous déplaçons en priorité absolue le jour même ou sous 24h ouvrées.
          </p>
          <div class="pt-2">
            <a href="tel:+32472902010" class="inline-flex items-center gap-2 bg-secondary hover:bg-secondary-container text-white py-3 px-5 rounded-xl font-extrabold text-sm shadow-md transition-all">
              <span class="material-symbols-outlined text-[18px]">call</span>
              <span>Ligne Directe Fuites : 0472 90 20 10</span>
            </a>
          </div>
        </div>

        <div class="bg-surface-container-low p-8 rounded-3xl border border-outline-variant/40 space-y-4">
          <div class="inline-flex items-center gap-2 text-primary font-bold text-xs uppercase tracking-wider">
            <span class="material-symbols-outlined text-[16px]">pin_drop</span> Déplacement Garanti
          </div>
          <h3 class="font-headline-md text-xl sm:text-2xl font-bold text-primary">Secteur Recherche de Fuite</h3>
          <ul class="text-xs sm:text-sm text-on-surface-variant space-y-2">
            <li><strong>Arlon et villages (6700) :</strong> Centre-ville, Bonnert, Weyler, Stockem, Heinsch, Freylange, Toernich.</li>
            <li><strong>Sud-Luxembourg :</strong> Messancy, Aubange, Athus, Habay, Attert, Étalle, Saint-Léger.</li>
            <li><strong>Copropriétés & Résidences :</strong> Interventions directes pour syndics et gestionnaires immobiliers.</li>
          </ul>
        </div>
      </div>

      <!-- Quote form -->
      <div id="quote-section">
        <QuickQuoteForm />
      </div>

    </div>
  </section>
</Layout>
