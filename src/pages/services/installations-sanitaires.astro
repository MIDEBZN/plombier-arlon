---
import Layout from '../../layouts/Layout.astro';
import TrustBar from '../../components/TrustBar.astro';
import QuickQuoteForm from '../../components/QuickQuoteForm.astro';
---

<Layout 
  title="Rénovation Salle de Bain & Sanitaire Arlon (6700) | WC Geberit, Douche Italienne"
  description="Artisan plombier pour rénovation complète de salle de bain à Arlon. Pose de douche à l'italienne, WC suspendu Geberit, robinetterie Grohe et mise aux normes plomberie. Devis gratuit au 0472 90 20 10."
  canonicalPath="/services/installations-sanitaires"
>
  <!-- Schema.org Service JSON-LD -->
  <script type="application/ld+json" slot="head">
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Rénovation Salle de Bain & Installations Sanitaires Arlon",
    "provider": {
      "@type": "Plumber",
      "name": "Plombier Arlon",
      "telephone": "+32472902010",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Rue des Faubourgs 14",
        "addressLocality": "Arlon",
        "postalCode": "6700",
        "addressCountry": "BE"
      }
    },
    "areaServed": [
      {"@type": "City", "name": "Arlon"},
      {"@type": "AdministrativeArea", "name": "Bonnert"},
      {"@type": "AdministrativeArea", "name": "Weyler"},
      {"@type": "AdministrativeArea", "name": "Messancy"},
      {"@type": "City", "name": "Steinfort"}
    ],
    "serviceType": "Bathroom Renovation & Sanitary Installation",
    "offers": {
      "@type": "Offer",
      "priceCurrency": "EUR",
      "price": "0.00",
      "description": "Visite technique et devis de rénovation salle de bain 100% gratuit"
    }
  }
  </script>

  <!-- Hero Section -->
  <section class="bg-primary text-white py-12 lg:py-16 border-b border-primary-container relative overflow-hidden">
    <div class="max-w-[1240px] mx-auto px-margin sm:px-margin-md space-y-5 relative z-10">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-secondary/20 text-secondary-fixed text-xs font-bold uppercase tracking-wider border border-secondary/30">
        <span class="material-symbols-outlined text-[16px]">bathtub</span>
        <span>Rénovation Clé en Main & Garantie Décennale 10 Ans</span>
      </div>
      <h1 class="font-headline-xl text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight">
        Installations Sanitaires & Rénovation de Salle de Bain à Arlon
      </h1>
      <p class="text-surface-container-highest max-w-3xl text-base sm:text-lg leading-relaxed">
        Envie d'une douche à l'italienne moderne, d'un WC suspendu élégant ou d'une rénovation complète de votre espace bain ? Nos artisans qualifiés conçoivent et réalisent votre projet avec des matériaux de premier choix certifiés Belgaqua.
      </p>
      
      <div class="flex flex-wrap gap-4 pt-2">
        <a href="tel:+32472902010" class="inline-flex items-center gap-2 bg-secondary hover:bg-secondary-container text-white px-6 py-3.5 rounded-xl font-extrabold shadow-lg transition-all text-sm sm:text-base">
          <span class="material-symbols-outlined text-[20px]">call</span>
          <span>Conseil Projet : 0472 90 20 10</span>
        </a>
        <a href="#quote-section" class="inline-flex items-center gap-2 bg-white/10 hover:bg-white/20 text-white px-5 py-3.5 rounded-xl font-bold border border-white/20 transition-all text-sm">
          <span>Demander un devis rénovation</span>
          <span class="material-symbols-outlined text-[18px]">arrow_downward</span>
        </a>
      </div>
    </div>
  </section>

  <TrustBar />

  <!-- Main Content -->
  <section class="py-16 bg-surface space-y-16">
    <div class="max-w-[1240px] mx-auto px-margin sm:px-margin-md space-y-16">

      <!-- 1. What's included -->
      <div class="bg-white rounded-3xl p-8 sm:p-12 border border-outline-variant/40 shadow-sm space-y-8">
        <div class="space-y-2">
          <span class="text-xs font-bold text-secondary uppercase tracking-widest">Nos Prestations Sanitaires</span>
          <h2 class="font-headline-lg text-2xl sm:text-3xl font-extrabold text-primary">
            Ce Qui Est Inclus dans Nos Prestations d'Installations Sanitaires
          </h2>
          <p class="text-on-surface-variant text-sm sm:text-base">
            De la pose d'un robinet thermostatique à la refonte complète de votre plomberie encastrée.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          <div class="p-5 rounded-2xl bg-surface-container-low border border-outline-variant/30 space-y-2">
            <span class="material-symbols-outlined text-secondary text-[26px]">shower</span>
            <h3 class="font-bold text-base text-primary">Douches à l'Italienne & Baignoires</h3>
            <p class="text-xs text-on-surface-variant leading-relaxed">Création de bac de douche de plain-pied, natte d'étanchéité certifiée sous carrelage (Schlüter-Systems), caniveau inox et parois vitrées securit anticalcaire.</p>
          </div>

          <div class="p-5 rounded-2xl bg-surface-container-low border border-outline-variant/30 space-y-2">
            <span class="material-symbols-outlined text-secondary text-[26px]">wc</span>
            <h3 class="font-bold text-base text-primary">WC Suspendus (Geberit Duofix)</h3>
            <p class="text-xs text-on-surface-variant leading-relaxed">Installation de bâti-support encastré, cuvette sans bride (Rimfree) ultra-hygiénique, plaque de déclenchement design et raccordement acoustique insonorisé.</p>
          </div>

          <div class="p-5 rounded-2xl bg-surface-container-low border border-outline-variant/30 space-y-2">
            <span class="material-symbols-outlined text-secondary text-[26px]">faucet</span>
            <h3 class="font-bold text-base text-primary">Robinetterie Haute Performance</h3>
            <p class="text-xs text-on-surface-variant leading-relaxed">Fourniture et raccordement de mitigeurs lavabo et colonnes de douche thermostatiques Grohe, Hansgrohe ou Van Marcke avec économiseurs d'eau.</p>
          </div>

          <div class="p-5 rounded-2xl bg-surface-container-low border border-outline-variant/30 space-y-2">
            <span class="material-symbols-outlined text-secondary text-[26px]">countertops</span>
            <h3 class="font-bold text-base text-primary">Meubles Vasques & Miroirs LED</h3>
            <p class="text-xs text-on-surface-variant leading-relaxed">Pose et raccordement de simples et doubles vasques, siphons gain de place, armoires de toilette rétroéclairées et meubles sous-vasque suspendus.</p>
          </div>

          <div class="p-5 rounded-2xl bg-surface-container-low border border-outline-variant/30 space-y-2">
            <span class="material-symbols-outlined text-secondary text-[26px]">autorenew</span>
            <h3 class="font-bold text-base text-primary">Rénovation Complète Tuyauterie</h3>
            <p class="text-xs text-on-surface-variant leading-relaxed">Suppression des anciennes canalisations en plomb ou acier galvanisé et remplacement par réseau multicouche isolé sous gaine ou cuivre serti.</p>
          </div>

          <div class="p-5 rounded-2xl bg-surface-container-low border border-outline-variant/30 space-y-2">
            <span class="material-symbols-outlined text-secondary text-[26px]">accessible</span>
            <h3 class="font-bold text-base text-primary">Aménagements PMR & Seniors</h3>
            <p class="text-xs text-on-surface-variant leading-relaxed">Remplacement d'une baignoire difficile d'accès par une douche de plain-pied avec barres de maintien, siège rabattable et sol antidérapant.</p>
          </div>
        </div>
      </div>

      <!-- 2. Common problems we solve -->
      <div class="space-y-8">
        <div class="space-y-2">
          <span class="text-xs font-bold text-primary uppercase tracking-widest">Pourquoi Rénover ?</span>
          <h2 class="font-headline-lg text-2xl sm:text-3xl font-extrabold text-primary">
            Les Problèmes Fréquents des Salles de Bain à Arlon
          </h2>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          <div class="bg-white p-6 rounded-2xl border border-outline-variant/40 shadow-sm space-y-3">
            <div class="h-10 w-10 rounded-xl bg-red-50 text-secondary flex items-center justify-center font-bold">1</div>
            <h3 class="font-bold text-base text-primary">Infiltrations sous Baignoire</h3>
            <p class="text-xs text-on-surface-variant leading-relaxed">Joints silicone noircis ou décollés provoquant des infiltrations d'eau lentes sous le carrelage et humidité dans les cloisons.</p>
          </div>

          <div class="bg-white p-6 rounded-2xl border border-outline-variant/40 shadow-sm space-y-3">
            <div class="h-10 w-10 rounded-xl bg-red-50 text-secondary flex items-center justify-center font-bold">2</div>
            <h3 class="font-bold text-base text-primary">Tuyauteries en Plomb Vétustes</h3>
            <p class="text-xs text-on-surface-variant leading-relaxed">Maisons de maître arlonaises avec conduits en plomb présentant un risque sanitaire et des risques accrus de rupture.</p>
          </div>

          <div class="bg-white p-6 rounded-2xl border border-outline-variant/40 shadow-sm space-y-3">
            <div class="h-10 w-10 rounded-xl bg-red-50 text-secondary flex items-center justify-center font-bold">3</div>
            <h3 class="font-bold text-base text-primary">Robinetterie Entartrée & Grippée</h3>
            <p class="text-xs text-on-surface-variant leading-relaxed">Cartouches céramiques bloquées par l'eau dure d'Arlon (+32 °fH), poignées dures à tourner et débit d'eau étouffé.</p>
          </div>

          <div class="bg-white p-6 rounded-2xl border border-outline-variant/40 shadow-sm space-y-3">
            <div class="h-10 w-10 rounded-xl bg-red-50 text-secondary flex items-center justify-center font-bold">4</div>
            <h3 class="font-bold text-base text-primary">Baignoire Inadaptée / Dangereuse</h3>
            <p class="text-xs text-on-surface-variant leading-relaxed">Accès difficile pour les personnes âgées, enjambement risqué et consommation d'eau excessive par rapport à une douche moderne.</p>
          </div>
        </div>
      </div>

      <!-- 3. Our process (step by step) -->
      <div class="bg-surface-container-low rounded-3xl p-8 sm:p-12 border border-outline-variant/40 space-y-8">
        <div class="space-y-2 text-center max-w-2xl mx-auto">
          <span class="text-xs font-bold text-secondary uppercase tracking-widest">Gestion de Chantier</span>
          <h2 class="font-headline-lg text-2xl sm:text-3xl font-extrabold text-primary">
            Comment se Déroule Votre Rénovation de Salle de Bain ?
          </h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-5 gap-6">
          <div class="bg-white p-6 rounded-2xl border border-outline-variant/30 space-y-3">
            <span class="h-8 w-8 rounded-full bg-primary text-white font-bold text-sm flex items-center justify-center">1</span>
            <h3 class="font-bold text-sm text-primary">Visite Technique</h3>
            <p class="text-xs text-on-surface-variant">Prise de cotes précises chez vous à Arlon, analyse des arrivées et évacuations existantes et écoute de vos envies.</p>
          </div>

          <div class="bg-white p-6 rounded-2xl border border-outline-variant/30 space-y-3">
            <span class="h-8 w-8 rounded-full bg-primary text-white font-bold text-sm flex items-center justify-center">2</span>
            <h3 class="font-bold text-sm text-primary">Devis & Choix Matériaux</h3>
            <p class="text-xs text-on-surface-variant">Présentation d'un devis chiffré poste par poste et sélection des sanitaires dans les showrooms partenaires (Van Marcke / Facq).</p>
          </div>

          <div class="bg-white p-6 rounded-2xl border border-outline-variant/30 space-y-3">
            <span class="h-8 w-8 rounded-full bg-primary text-white font-bold text-sm flex items-center justify-center">3</span>
            <h3 class="font-bold text-sm text-primary">Dépose & Plomberie</h3>
            <p class="text-xs text-on-surface-variant">Démontage soigné des anciens sanitaires, reprise des circuits d'eau chaude/froide et pose des évacuations avec pente idéale.</p>
          </div>

          <div class="bg-white p-6 rounded-2xl border border-outline-variant/30 space-y-3">
            <span class="h-8 w-8 rounded-full bg-primary text-white font-bold text-sm flex items-center justify-center">4</span>
            <h3 class="font-bold text-sm text-primary">Étanchéité & Pose</h3>
            <p class="text-xs text-on-surface-variant">Application de la membrane d'étanchéité sous carrelage et installation minutieuse de vos équipements sanitaires.</p>
          </div>

          <div class="bg-white p-6 rounded-2xl border border-outline-variant/30 space-y-3">
            <span class="h-8 w-8 rounded-full bg-primary text-white font-bold text-sm flex items-center justify-center">5</span>
            <h3 class="font-bold text-sm text-primary">Réception & Garantie 10 Ans</h3>
            <p class="text-xs text-on-surface-variant">Test complet de débit et d'étanchéité, nettoyage du chantier et remise du certificat de garantie décennale.</p>
          </div>
        </div>
      </div>

      <!-- 4. Why choose us -->
      <div class="bg-white rounded-3xl p-8 sm:p-12 border border-outline-variant/40 shadow-sm space-y-8">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
          <div class="lg:col-span-7 space-y-4">
            <span class="text-xs font-bold text-secondary uppercase tracking-widest">Garantie & Partenaires</span>
            <h2 class="font-headline-lg text-2xl sm:text-3xl font-extrabold text-primary">
              Pourquoi Confier Votre Salle de Bain à Nos Artisans ?
            </h2>
            <div class="space-y-3 text-sm text-on-surface-variant">
              <p class="flex items-start gap-2.5">
                <span class="material-symbols-outlined text-emerald-600 text-[20px] shrink-0 mt-0.5">verified</span>
                <span><strong>Interlocuteur unique du début à la fin :</strong> Pas de sous-traitance à rallonge. Nos propres plombiers qualifiés gèrent l'intégralité de vos raccordements.</span>
              </p>
              <p class="flex items-start gap-2.5">
                <span class="material-symbols-outlined text-emerald-600 text-[20px] shrink-0 mt-0.5">verified</span>
                <span><strong>Partenariat avec les grands comptoirs belges :</strong> Accès aux tarifs professionnels et aux catalogues haut de gamme chez Van Marcke, Facq et Desco.</span>
              </p>
              <p class="flex items-start gap-2.5">
                <span class="material-symbols-outlined text-emerald-600 text-[20px] shrink-0 mt-0.5">verified</span>
                <span><strong>Garantie décennale légale :</strong> Tous nos travaux de tuyauterie encastrée et d'étanchéité de douche sont couverts par notre assurance décennale belge.</span>
              </p>
            </div>
          </div>

          <div class="lg:col-span-5 bg-surface-container-low p-6 sm:p-8 rounded-2xl border border-outline-variant/30 text-center space-y-4">
            <span class="text-xs font-bold text-outline uppercase tracking-wider">Étude & Devis à Domicile</span>
            <p class="text-3xl font-extrabold text-primary">100% Gratuit <span class="text-xs font-normal text-on-surface-variant">sans engagement</span></p>
            <p class="text-xs text-on-surface-variant">Visite technique sur place à Arlon et remise d'un devis détaillé sous 48h.</p>
            <a href="tel:+32472902010" class="w-full inline-flex items-center justify-center gap-2 bg-secondary hover:bg-secondary-container text-white py-3.5 px-4 rounded-xl font-bold text-sm shadow-md transition-all">
              <span class="material-symbols-outlined text-[18px]">call</span>
              <span>Demander Ma Visite : 0472 90 20 10</span>
            </a>
          </div>
        </div>
      </div>

      <!-- 5. FAQs -->
      <div class="space-y-6">
        <div class="space-y-2">
          <span class="text-xs font-bold text-primary uppercase tracking-widest">Foire Aux Questions</span>
          <h2 class="font-headline-lg text-2xl sm:text-3xl font-extrabold text-primary">
            Questions Fréquentes sur la Rénovation Sanitaire
          </h2>
        </div>

        <div class="space-y-4">
          <details class="group bg-white rounded-xl border border-outline-variant/40 p-5 open:shadow-sm">
            <summary class="font-bold text-sm sm:text-base text-primary cursor-pointer flex items-center justify-between list-none">
              <span>Combien de temps durent les travaux de rénovation d'une salle de bain ?</span>
              <span class="material-symbols-outlined group-open:rotate-180 transition-transform">expand_more</span>
            </summary>
            <p class="text-xs sm:text-sm text-on-surface-variant mt-3 leading-relaxed">
              Pour une transformation simple (ex : remplacement d'une baignoire par une douche italienne et pose d'un WC suspendu), comptez entre 3 et 5 jours ouvrés. Pour une rénovation intégrale avec démolition de carrelage et reprise de chape, il faut compter entre 7 et 10 jours ouvrés.
            </p>
          </details>

          <details class="group bg-white rounded-xl border border-outline-variant/40 p-5 open:shadow-sm">
            <summary class="font-bold text-sm sm:text-base text-primary cursor-pointer flex items-center justify-between list-none">
              <span>Pourquoi privilégier un WC suspendu Geberit ?</span>
              <span class="material-symbols-outlined group-open:rotate-180 transition-transform">expand_more</span>
            </summary>
            <p class="text-xs sm:text-sm text-on-surface-variant mt-3 leading-relaxed">
              Geberit est le leader mondial du bâti-support. Leurs mécanismes encastrés sont garantis 25 ans de disponibilité de pièces détachées sans casser le mur (accès direct via la plaque de commande). De plus, le nettoyage du sol est rendu ultra-rapide et l'esthétique de la pièce est grandement valorisée.
            </p>
          </details>

          <details class="group bg-white rounded-xl border border-outline-variant/40 p-5 open:shadow-sm">
            <summary class="font-bold text-sm sm:text-base text-primary cursor-pointer flex items-center justify-between list-none">
              <span>Pouvez-vous adapter une salle de bain pour une personne à mobilité réduite (PMR) ?</span>
              <span class="material-symbols-outlined group-open:rotate-180 transition-transform">expand_more</span>
            </summary>
            <p class="text-xs sm:text-sm text-on-surface-variant mt-3 leading-relaxed">
              Oui, nous réalisons des aménagements certifiés PMR : douche extra-plate sans aucun ressaut, barres d'appui murales renforcées, mitigeurs ergonomiques anti-brûlure et WC suspendu rehaussé facilitant le transfert en toute sécurité.
            </p>
          </details>
        </div>
      </div>

      <!-- 6. Emergency availability & 7. Service area details -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <div class="bg-primary text-white p-8 rounded-3xl space-y-4">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/10 text-secondary-fixed text-xs font-bold uppercase">
            <span class="material-symbols-outlined text-[16px]">event_available</span> Rendez-Vous Rapide
          </div>
          <h3 class="font-headline-md text-xl sm:text-2xl font-bold">Étude de Projet sous 48h</h3>
          <p class="text-surface-container-highest text-sm leading-relaxed">
            Contactez-nous pour convenir d'une visite technique gratuite sur place. Nous venons analyser l'agencement existant et vous remettons notre proposition détaillée sans aucun engagement.
          </p>
          <div class="pt-2">
            <a href="tel:+32472902010" class="inline-flex items-center gap-2 bg-secondary hover:bg-secondary-container text-white py-3 px-5 rounded-xl font-extrabold text-sm shadow-md transition-all">
              <span class="material-symbols-outlined text-[18px]">call</span>
              <span>Ligne Projets : 0472 90 20 10</span>
            </a>
          </div>
        </div>

        <div class="bg-surface-container-low p-8 rounded-3xl border border-outline-variant/40 space-y-4">
          <div class="inline-flex items-center gap-2 text-primary font-bold text-xs uppercase tracking-wider">
            <span class="material-symbols-outlined text-[16px]">location_city</span> Secteurs Rénovation
          </div>
          <h3 class="font-headline-md text-xl sm:text-2xl font-bold text-primary">Intervention Rénovation</h3>
          <ul class="text-xs sm:text-sm text-on-surface-variant space-y-2">
            <li><strong>Arlon (6700) :</strong> Maisons de ville, appartements, villas à Bonnert, Weyler, Viville.</li>
            <li><strong>Sud-Luxembourg :</strong> Messancy, Aubange, Habay, Attert, Étalle, Saint-Léger.</li>
            <li><strong>Frontaliers Grand-Duché :</strong> Steinfort, Capellen, Mamer, Windhof.</li>
          </ul>
        </div>
      </div>

      <!-- Quote form -->
      <div id="quote-section">
        <QuickQuoteForm />
      </div>

    </div>
  </section>
</Layout>
